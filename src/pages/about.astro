---
// Ported from t3nk-old AboutPage.vue.
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { url } from '../consts';

const howWeWork = [
	{ title: 'Invest early', desc: 'Pre-seed to Series A. Software companies with technical founders.' },
	{ title: 'Join the repo', desc: 'Our engineers work in your codebase, not around it.' },
	{ title: 'Help you hire', desc: 'We define roles and interview the first engineers with you.' },
	{
		title: 'Stay through scale',
		desc: 'We are involved through the first scaling problems, not just the first release.',
	},
];
---

<Layout title="Capital. Then Code.">
	<div class="about">
		<!-- Spacer for fixed header to create "white margin" effect -->
		<div class="about-spacer"></div>

		<div class="about-pad">
			<!-- Hero Section -->
			<div class="container about-hero">
				<div class="about-hero-rule">
					<h1 class="about-title">
						CAPITAL.<br />
						<span class="fade-text">THEN CODE.</span>
					</h1>
					<p class="about-hero-sub">
						T3NK is the engineering-first VC. We invest in early-stage software companies, then our team joins
						the repo.
					</p>
				</div>
			</div>

			<!-- Why T3NK -->
			<section class="about-why">
				<div class="container">
					<div class="why-grid">
						<div>
							<h2 class="why-title">
								<span class="why-icon">
									<Icon name="git-merge" size={32} />
								</span>
								WHY T3NK
							</h2>
							<p class="why-text">
								Venture is often run by people who have never had to ship a production system. Founders get
								capital and a board seat, then hire their own engineers to fix the technical decisions nobody in
								the room can evaluate.
							</p>
							<p class="why-text why-text-gap">
								T3NK was built to close that gap. Our partners have built trading systems, logistics platforms,
								enterprise software, and early-stage products. We invest, and then we work.
							</p>
						</div>

						<div class="how-cards">
							{
								howWeWork.map((item) => (
									<div class="how-card">
										<h3 class="how-card-title">{item.title}</h3>
										<p class="how-card-desc">{item.desc}</p>
									</div>
								))
							}
						</div>
					</div>
				</div>
			</section>

			<!-- How We Work -->
			<section class="rules">
				<div class="container">
					<div class="rules-head">
						<span class="rules-icon">
							<Icon name="target" size={48} />
						</span>
						<div>
							<h2 class="rules-title">HOW WE WORK</h2>
							<p class="rules-sub">Three rules that decide where we spend time.</p>
						</div>
					</div>

					<div class="rules-grid">
						<!-- Point 1 -->
						<div class="rule">
							<h3 class="rule-title">Technical decisions compound</h3>
							<p class="rule-text">
								Architecture choices made in month two are expensive to reverse in month eighteen. We help make
								the few decisions that are hard to undo.
							</p>
						</div>

						<!-- Point 2 -->
						<div class="rule">
							<h3 class="rule-title">Business logic is the easy part</h3>
							<p class="rule-text">
								The model is usually simple. Building a reliable system around it is not. We spend our time on
								the implementation layer, where value is created and lost.
							</p>
						</div>

						<!-- Point 3 -->
						<div class="rule">
							<h3 class="rule-title">Operators, not observers</h3>
							<p class="rule-text">
								We review PRs, sit in architecture calls, and help you interview your first engineers. We are
								useful before we are impressive.
							</p>
						</div>
					</div>

					<div class="practice">
						<h4 class="practice-title">
							<span class="practice-icon">
								<Icon name="cpu" size={20} />
							</span>
							Capital + code, in practice
						</h4>
						<p class="practice-text">
							We invest early, join your repository, and stay through the first scaling problems. We do not hand
							off a prototype and leave.
						</p>
					</div>
				</div>
			</section>

			<!-- Call to Action -->
			<section class="about-cta">
				<h2 class="cta-title">Bring us the hard part.</h2>
				<p class="cta-sub">If the risk in your company is technical, we should talk.</p>
				<div class="cta-actions">
					<a href={url('pitch')} class="cta-solid">
						<Icon name="zap" size={20} /> PITCH US
					</a>
					<a href={url('#contact')} class="cta-ghost">CONTACT</a>
				</div>
			</section>
		</div>
	</div>
</Layout>

<style>
	.about {
		background: var(--black);
		color: var(--white);
		min-height: 100vh;
	}

	/* White strip below the fixed header */
	.about-spacer {
		height: 6rem;
		background: var(--white);
		width: 100%;
	}

	.about-pad {
		padding-top: 6rem;
		padding-bottom: 3rem;
	}

	/* Hero */
	.about-hero {
		margin-bottom: 6rem;
	}

	.about-hero-rule {
		border-bottom: 1px solid rgba(255, 255, 255, 0.2);
		padding-bottom: 3rem;
		margin-bottom: 3rem;
	}

	.about-title {
		font-size: 4.5rem;
		font-weight: 900;
		letter-spacing: -0.05em;
		margin-bottom: 1.5rem;
		line-height: 0.8;
	}

	.fade-text {
		color: transparent;
		background-image: linear-gradient(to right, var(--white), var(--gray-400), var(--gray-600));
		-webkit-background-clip: text;
		background-clip: text;
	}

	.about-hero-sub {
		font-size: 1.25rem;
		font-family: var(--font-mono);
		color: var(--gray-400);
		max-width: 42rem;
	}

	/* Why T3NK */
	.about-why {
		margin-bottom: 8rem;
	}

	.why-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 4rem;
	}

	.why-title {
		font-size: 2.25rem;
		font-weight: 700;
		margin-bottom: 2rem;
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.why-icon :global(svg) {
		color: var(--gray-500);
	}

	.why-text {
		font-size: 1.125rem;
		color: var(--gray-300);
		margin-bottom: 1.5rem;
		line-height: 1.625;
	}

	.why-text-gap {
		margin-bottom: 0;
	}

	.how-cards > * + * {
		margin-top: 1rem;
	}

	.how-card {
		padding: 1.5rem;
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 0.5rem;
		background: rgba(255, 255, 255, 0.05);
		transition: background-color 0.15s ease;
	}

	.how-card:hover {
		background: rgba(255, 255, 255, 0.1);
	}

	.how-card-title {
		font-family: var(--font-mono);
		font-size: 1.25rem;
		font-weight: 700;
		color: var(--gray-200);
	}

	.how-card-desc {
		font-size: 0.875rem;
		color: var(--gray-500);
		margin-top: 0.5rem;
	}

	/* How we work */
	.rules {
		background: var(--white);
		color: var(--black);
		padding: 6rem 1.5rem;
	}

	.rules .container {
		max-width: 80rem;
		margin: 0 auto;
	}

	.rules-head {
		display: flex;
		align-items: flex-start;
		gap: 1rem;
		margin-bottom: 3rem;
	}

	.rules-title {
		font-size: 3rem;
		font-weight: 900;
		letter-spacing: -0.05em;
	}

	.rules-sub {
		font-family: var(--font-mono);
		font-size: 0.875rem;
		color: var(--gray-500);
		margin-top: 0.5rem;
	}

	.rules-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 3rem;
	}

	.rule > * + * {
		margin-top: 1rem;
	}

	.rule-title {
		font-size: 1.5rem;
		font-weight: 700;
		border-bottom: 2px solid var(--black);
		padding-bottom: 0.5rem;
	}

	.rule-text {
		font-family: var(--font-mono);
		font-size: 0.875rem;
		line-height: 1.625;
		opacity: 0.8;
	}

	.practice {
		margin-top: 4rem;
		padding: 2rem;
		background: var(--gray-100);
		border-radius: 0.75rem;
		border: 1px solid var(--gray-300);
	}

	.practice-title {
		font-weight: 700;
		font-size: 1.25rem;
		margin-bottom: 1rem;
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.practice-text {
		color: var(--gray-700);
		max-width: 48rem;
	}

	/* CTA */
	.about-cta {
		max-width: 80rem;
		margin: 0 auto;
		padding: 8rem 1.5rem;
		text-align: center;
	}

	.cta-title {
		font-size: 2.25rem;
		font-weight: 900;
		margin-bottom: 1.5rem;
	}

	.cta-sub {
		color: var(--gray-400);
		font-family: var(--font-mono);
		margin-bottom: 2.5rem;
	}

	.cta-actions {
		display: flex;
		justify-content: center;
		gap: 1.5rem;
	}

	.cta-solid {
		background: var(--white);
		color: var(--black);
		padding: 1rem 2rem;
		font-weight: 700;
		transition: background-color 0.15s ease;
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.cta-solid:hover {
		background: var(--gray-200);
	}

	.cta-ghost {
		border: 1px solid rgba(255, 255, 255, 0.3);
		padding: 1rem 2rem;
		font-weight: 700;
		transition: background-color 0.15s ease;
	}

	.cta-ghost:hover {
		background: rgba(255, 255, 255, 0.1);
	}

	@media (min-width: 768px) {
		.about-title {
			font-size: 8rem;
		}
		.why-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
		.cta-title {
			font-size: 3.75rem;
		}
	}

	@media (min-width: 1024px) {
		.rules-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
</style>
