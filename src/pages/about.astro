---
// Ported from t3nk-old AboutPage.vue.
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { url } from '../consts';

const howWeWork = [
	{ title: 'Invest early', desc: 'Pre-seed to Series A. Software companies with technical founders.' },
	{ title: 'Join the repo', desc: 'Our engineers work in your codebase, not around it.' },
	{ title: 'Help you hire', desc: 'We define roles and interview the first engineers with you.' },
	{
		title: 'Stay through scale',
		desc: 'We are involved through the first scaling problems, not just the first release.',
	},
];
---

<Layout title="Capital. Then Code.">
	<div class="bg-black text-white min-h-screen">
		<!-- Spacer for fixed header to create "white margin" effect -->
		<div class="h-24 bg-white w-full"></div>

		<div class="pt-24 pb-12">
			<!-- Hero Section -->
			<div class="max-w-7xl mx-auto px-6 mb-24">
				<div class="border-b border-white/20 pb-12 mb-12">
					<h1 class="text-7xl md:text-9xl font-black tracking-tighter mb-6 leading-[0.8]">
						CAPITAL.<br />
						<span class="text-transparent bg-clip-text bg-gradient-to-r from-white via-gray-400 to-gray-600">THEN CODE.</span>
					</h1>
					<p class="text-xl md:text-2xl font-mono text-gray-400 max-w-2xl">
						T3NK is the engineering-first VC. We invest in early-stage software companies, then our team joins
						the repo.
					</p>
				</div>
			</div>

			<!-- Why T3NK -->
			<section class="max-w-7xl mx-auto px-6 mb-32">
				<div class="grid grid-cols-1 md:grid-cols-2 gap-16">
					<div>
						<h2 class="text-4xl font-bold mb-8 flex items-center gap-3">
							<Icon name="git-merge" size={32} class="text-gray-500" />
							WHY T3NK
						</h2>
						<p class="text-lg text-gray-300 mb-6 leading-relaxed">
							Venture is often run by people who have never had to ship a production system. Founders get
							capital and a board seat, then hire their own engineers to fix the technical decisions nobody in
							the room can evaluate.
						</p>
						<p class="text-lg text-gray-300 leading-relaxed">
							T3NK was built to close that gap. Our partners have built trading systems, logistics platforms,
							enterprise software, and early-stage products. We invest, and then we work.
						</p>
					</div>

					<div class="space-y-4">
						{
							howWeWork.map((item) => (
								<div class="p-6 border border-white/10 rounded-lg bg-white/5 hover:bg-white/10 transition-colors">
									<h3 class="font-mono text-xl font-bold text-gray-200">{item.title}</h3>
									<p class="text-sm text-gray-500 mt-2">{item.desc}</p>
								</div>
							))
						}
					</div>
				</div>
			</section>

			<!-- How We Work -->
			<section class="bg-white text-black py-24 px-6">
				<div class="max-w-7xl mx-auto">
					<div class="flex items-start gap-4 mb-12">
						<Icon name="target" size={48} />
						<div>
							<h2 class="text-5xl font-black tracking-tighter">HOW WE WORK</h2>
							<p class="font-mono text-sm text-gray-500 mt-2">Three rules that decide where we spend time.</p>
						</div>
					</div>

					<div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
						<!-- Point 1 -->
						<div class="space-y-4">
							<h3 class="text-2xl font-bold border-b-2 border-black pb-2">Technical decisions compound</h3>
							<p class="font-mono text-sm leading-relaxed opacity-80">
								Architecture choices made in month two are expensive to reverse in month eighteen. We help make
								the few decisions that are hard to undo.
							</p>
						</div>

						<!-- Point 2 -->
						<div class="space-y-4">
							<h3 class="text-2xl font-bold border-b-2 border-black pb-2">Business logic is the easy part</h3>
							<p class="font-mono text-sm leading-relaxed opacity-80">
								The model is usually simple. Building a reliable system around it is not. We spend our time on
								the implementation layer, where value is created and lost.
							</p>
						</div>

						<!-- Point 3 -->
						<div class="space-y-4">
							<h3 class="text-2xl font-bold border-b-2 border-black pb-2">Operators, not observers</h3>
							<p class="font-mono text-sm leading-relaxed opacity-80">
								We review PRs, sit in architecture calls, and help you interview your first engineers. We are
								useful before we are impressive.
							</p>
						</div>
					</div>

					<div class="mt-16 p-8 bg-gray-100 rounded-xl border border-gray-300">
						<h4 class="font-bold text-xl mb-4 flex items-center gap-2">
							<Icon name="cpu" size={20} />
							Capital + code, in practice
						</h4>
						<p class="text-gray-700 max-w-3xl">
							We invest early, join your repository, and stay through the first scaling problems. We do not hand
							off a prototype and leave.
						</p>
					</div>
				</div>
			</section>

			<!-- Call to Action -->
			<section class="max-w-7xl mx-auto px-6 py-32 text-center">
				<h2 class="text-4xl md:text-6xl font-black mb-6">Bring us the hard part.</h2>
				<p class="text-gray-400 font-mono mb-10">If the risk in your company is technical, we should talk.</p>
				<div class="flex justify-center gap-6">
					<a
						href={url('pitch')}
						class="bg-white text-black px-8 py-4 font-bold hover:bg-gray-200 transition-colors flex items-center gap-2"
					>
						<Icon name="zap" size={20} /> PITCH US
					</a>
					<a
						href={url('#contact')}
						class="border border-white/30 px-8 py-4 font-bold hover:bg-white/10 transition-colors"
					>
						CONTACT
					</a>
				</div>
			</section>
		</div>
	</div>
</Layout>
