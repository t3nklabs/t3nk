---
import Layout from '../../layouts/Layout.astro';
import { asset } from '../../consts';
import WorkFeed from '../../components/WorkFeed.astro';
import { getCollection } from 'astro:content';

const entries = await getCollection('work');
---

<Layout
	title="Work"
	description="Products and open-source tools built by the T3NK team — projects, updates and the changelog behind them."
	image={asset('/og/work.png')}
	imageAlt="WORK — products and open-source tools built by the T3NK team."
>
	<div class="work-page">
		<div class="work-head">
			<h1 class="work-title">WORK</h1>
			<p class="work-sub">Products and open-source tools built by our team.</p>
		</div>

		<WorkFeed entries={entries} active="all" />
	</div>
</Layout>

<style>
	.work-page {
		padding-top: 6rem;
		min-height: 100vh;
		background: var(--gray-50);
	}

	.work-head {
		max-width: 80rem;
		margin: 0 auto 2.5rem;
		padding: 1.5rem 1.5rem 0;
		text-align: center;
	}

	.work-title {
		font-size: 2.25rem;
		font-weight: 900;
		margin-bottom: 1rem;
		letter-spacing: -0.025em;
	}

	.work-sub {
		font-size: 1.25rem;
		color: var(--gray-500);
		font-family: var(--font-mono);
	}

	@media (min-width: 768px) {
		.work-title {
			font-size: 3.75rem;
		}
	}
</style>
