---
// /work sub-pages, all generated statically:
//   /work/projects, /work/updates         — kind feeds
//   /work/tag/<tag>                       — tag feeds (AI/ML -> /work/tag/ai-ml)
//   /work/<entry-id>                      — detail page (project or update)
// Reserved feed slugs: "projects", "updates", "tag/*". Avoid entry ids with
// those names (enforced by the collision assertion below).
import Layout from '../../layouts/Layout.astro';
import EntryDetail from '../../components/work/EntryDetail.astro';
import WorkFeed from '../../components/WorkFeed.astro';
import { slugify, byOrder, byDateDesc } from '../../lib/work';
import { url, asset } from '../../consts';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
	const entries = await getCollection('work');
	const projects = entries.filter((entry) => entry.data.kind === 'project').sort(byOrder);
	const updates = entries.filter((entry) => entry.data.kind === 'update').sort(byDateDesc);
	const projectTitles = new Map(projects.map((project) => [project.id, project.data.title]));
	const tags = [...new Set(entries.flatMap((entry) => entry.data.tags))];

	// Entry ids must not shadow the reserved feed slugs.
	const reserved = new Set(['projects', 'updates', 'work']);
	const clash = entries.filter((entry) => reserved.has(entry.id) || entry.id.startsWith('tag/'));
	if (clash.length > 0) {
		throw new Error(`Work entry ids collide with reserved feed slugs: ${clash.map((c) => c.id).join(', ')}`);
	}

	return [
		{
			params: { slug: 'projects' },
			props: { kind: 'feed', active: 'projects', subtitle: 'Products and open-source built by T3NK.', entries: projects },
		},
		{
			params: { slug: 'updates' },
			props: { kind: 'feed', active: 'updates', subtitle: 'Changelog — what we shipped and what changed.', entries: updates },
		},
		...tags.map((tag) => ({
			params: { slug: `tag/${slugify(tag)}` },
			props: {
				kind: 'feed',
				active: slugify(tag),
				subtitle: `Tagged “${tag}”.`,
				entries: entries.filter((entry) => entry.data.tags.includes(tag)),
			},
		})),
		...entries.map((entry) => ({
			params: { slug: entry.id },
			props: {
				kind: 'detail',
				entry,
				relatedUpdates: entry.data.kind === 'project' ? updates.filter((u) => u.data.project === entry.id) : [],
				projectTitles,
			},
		})),
	];
}

type FeedProps = {
	kind: 'feed';
	active: string;
	subtitle: string;
	entries: CollectionEntry<'work'>[];
};

type DetailProps = {
	kind: 'detail';
	entry: CollectionEntry<'work'>;
	relatedUpdates: CollectionEntry<'work'>[];
	projectTitles: Map<string, string>;
};

type Props = FeedProps | DetailProps;

const props = Astro.props as Props;
const isFeed = props.kind === 'feed';
const pageTitle = !isFeed ? props.entry.data.title : props.active === 'all' ? 'Work' : `${props.active} — Work`;
const description = !isFeed
	? props.entry.data.desc
	: 'Products and open-source tools built by the T3NK team — projects, updates and the changelog behind them.';

// Structured data for detail pages, matching the organization defined in BaseHead.
const siteURL = new URL('/', Astro.site).toString();
const tagToCategory = {
	TOOL: 'UtilitiesApplication',
	WEB3: 'WebApplication',
	PRIVACY: 'SecurityApplication',
	'AI/ML': 'AIApplication',
} as const;
const schemaJSON =
	props.kind === 'detail'
		? JSON.stringify(
				props.entry.data.kind === 'project'
					? {
							'@context': 'https://schema.org',
							'@type': 'SoftwareApplication',
							name: props.entry.data.title,
							description: props.entry.data.desc,
							url: props.entry.data.url ?? new URL(url(`work/${props.entry.id}`), Astro.site).toString(),
							sameAs: props.entry.data.url ? new URL(url(`work/${props.entry.id}`), Astro.site).toString() : undefined,
							applicationCategory: tagToCategory[props.entry.data.tags[0]] ?? 'SoftwareApplication',
							operatingSystem: 'Web',
							author: { '@id': `${siteURL}#organization` },
							publisher: { '@id': `${siteURL}#organization` },
						}
					: {
							'@context': 'https://schema.org',
							'@type': 'Article',
							headline: props.entry.data.title,
							description: props.entry.data.desc,
							datePublished: props.entry.data.date,
							author: { '@id': `${siteURL}#organization` },
							publisher: { '@id': `${siteURL}#organization` },
						},
			)
		: null;
---

<Layout
	title={pageTitle}
	description={description}
	ogType={isFeed ? 'website' : 'article'}
	image={props.kind === 'detail' ? asset(`/og/work/${props.entry.id}.png`) : undefined}
	imageAlt={props.kind === 'detail' ? `${props.entry.data.title} — T3NK work card` : undefined}
>
	{schemaJSON && <script is:inline type="application/ld+json" set:html={schemaJSON} />}
	{
		isFeed ? (
			<div class="work-page">
				<div class="work-head">
					<h1 class="work-title">WORK</h1>
					<p class="work-sub">{props.subtitle}</p>
				</div>
				<WorkFeed entries={props.entries} active={props.active} />
			</div>
		) : (
			<EntryDetail
				entry={props.entry}
				relatedUpdates={props.relatedUpdates}
				projectTitles={props.projectTitles}
			/>
		)
	}
</Layout>

<style>
	.work-page {
		padding-top: 6rem;
		min-height: 100vh;
		background: var(--gray-50);
	}

	.work-head {
		max-width: 80rem;
		margin: 0 auto 2.5rem;
		padding: 1.5rem 1.5rem 0;
		text-align: center;
	}

	.work-title {
		font-size: 2.25rem;
		font-weight: 900;
		margin-bottom: 1rem;
		letter-spacing: -0.025em;
	}

	.work-sub {
		font-size: 1.25rem;
		color: var(--gray-500);
		font-family: var(--font-mono);
	}

	@media (min-width: 768px) {
		.work-title {
			font-size: 3.75rem;
		}
	}
</style>
