---
// POSTS index — the writing feed. Newest first, numbered, tabs per series.
import Layout from '../../layouts/Layout.astro';
import { asset } from '../../consts';
import PostsTabs from '../../components/PostsTabs.astro';
import PostRow from '../../components/PostRow.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts')).sort(
	(a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const total = posts.length;
---

<Layout
	title="Posts"
	description="Notes from the T3NK partners — decision notes, engineering logs and signals from the edge of capital + code."
	image={asset('/og/posts.png')}
	imageAlt="POSTS — decisions, engineering logs and signals from the T3NK partners. Not a blog."
>
	<div class="posts-page">
		<div class="posts-head">
			<h1 class="posts-title">POSTS</h1>
			<p class="posts-sub">Decisions, engineering logs and signals. Not a blog.</p>
			<PostsTabs active="" />
		</div>

		<div class="posts-list">
			{
				posts.map((post, i) => (
					<PostRow post={post} no={total - i} />
				))
			}
		</div>
	</div>
</Layout>

<style>
	.posts-page {
		padding-top: 6rem;
		min-height: 100vh;
		background: var(--gray-50);
	}

	.posts-head {
		max-width: 56rem;
		margin: 0 auto 3rem;
		padding: 1.5rem 1.5rem 0;
	}

	.posts-title {
		font-size: 2.25rem;
		font-weight: 900;
		margin-bottom: 1rem;
		letter-spacing: -0.025em;
	}

	.posts-sub {
		font-size: 1.125rem;
		color: var(--gray-500);
		font-family: var(--font-mono);
	}

	.posts-list {
		max-width: 56rem;
		margin: 0 auto;
		padding: 0 1.5rem 6rem;
		display: grid;
		gap: 1rem;
	}
</style>
