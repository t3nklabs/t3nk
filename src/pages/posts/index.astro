---
// POSTS index — the writing feed. Newest first, card list like /work.
import Layout from '../../layouts/Layout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { url } from '../../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts')).sort(
	(a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<Layout title="Posts" description="Notes from the T3NK partners — decision notes, engineering logs and signals from the edge of capital + code.">
	<div class="posts-page">
		<div class="posts-head">
			<h1 class="posts-title">POSTS</h1>
			<p class="posts-sub">Decisions, engineering logs and signals. Not a blog.</p>
		</div>

		<div class="posts-list">
			{
				posts.map((post, i) => (
					<a href={url(`posts/${post.id}`)} class="post-row" aria-label={post.data.title}>
						<span class="post-no">#{String(posts.length - i).padStart(2, '0')}</span>
						<div class="post-main">
							<h2 class="post-title">{post.data.title}</h2>
							<p class="post-desc">{post.data.desc}</p>
							{post.data.tags.length > 0 && (
								<div class="post-tags">
									{post.data.tags.map((tag) => (
										<span class="post-tag">{tag}</span>
									))}
								</div>
							)}
						</div>
						<div class="post-side">
							{post.data.date && <FormattedDate date={post.data.date} />}
						</div>
					</a>
				))
			}
		</div>
	</div>
</Layout>

<style>
	.posts-page {
		padding-top: 6rem;
		min-height: 100vh;
		background: var(--gray-50);
	}

	.posts-head {
		max-width: 56rem;
		margin: 0 auto 3rem;
		padding: 1.5rem 1.5rem 0;
	}

	.posts-title {
		font-size: 2.25rem;
		font-weight: 900;
		margin-bottom: 1rem;
		letter-spacing: -0.025em;
	}

	.posts-sub {
		font-size: 1.125rem;
		color: var(--gray-500);
		font-family: var(--font-mono);
	}

	.posts-list {
		max-width: 56rem;
		margin: 0 auto;
		padding: 0 1.5rem 6rem;
		display: grid;
		gap: 1rem;
	}

	.post-row {
		display: grid;
		grid-template-columns: 3.5rem 1fr auto;
		gap: 1rem;
		align-items: start;
		padding: 1.5rem;
		background: var(--white);
		border: 1px solid var(--gray-100);
		border-radius: 0.75rem;
		transition: border-color 0.3s ease, transform 0.3s ease;
	}

	.post-row:hover {
		border-color: var(--black);
		transform: translateY(-0.25rem);
	}

	.post-no {
		font-family: var(--font-mono);
		font-size: 0.875rem;
		color: var(--gray-400);
		padding-top: 0.25rem;
	}

	.post-title {
		font-size: 1.375rem;
		font-weight: 800;
		letter-spacing: -0.015em;
		margin-bottom: 0.5rem;
	}

	.post-desc {
		font-size: 0.9375rem;
		color: var(--gray-500);
		line-height: 1.625;
	}

	.post-tags {
		display: flex;
		gap: 0.375rem;
		margin-top: 0.75rem;
	}

	.post-tag {
		font-family: var(--font-mono);
		font-size: 0.625rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--gray-500);
		background: var(--gray-100);
		padding: 0.25rem 0.5rem;
		border-radius: 0.25rem;
		font-weight: 700;
	}

	.post-side {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--gray-400);
		padding-top: 0.35rem;
		white-space: nowrap;
	}

	@media (max-width: 640px) {
		.post-row {
			grid-template-columns: 1fr;
			gap: 0.5rem;
		}
		.post-side {
			order: -1;
		}
	}
</style>
