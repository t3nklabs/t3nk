---
// /posts sub-pages, all generated statically:
//   /posts/tag/<tag>   — series/tag feeds (DECISION NOTES -> /posts/tag/decision-notes)
//   /posts/<entry-id>  — a single post
import Layout from '../../layouts/Layout.astro';
import PostsTabs from '../../components/PostsTabs.astro';
import PostRow from '../../components/PostRow.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { render, getCollection } from 'astro:content';
import { slugify } from '../../lib/work';
import { url, asset } from '../../consts';

export async function getStaticPaths() {
	const posts = await getCollection('posts');
	const tags = [...new Set(posts.flatMap((post) => post.data.tags))];
	// Post ids must not shadow the reserved feed slugs.
	const reserved = posts.filter((post) => post.id.startsWith('tag/') || post.id === 'tag');
	if (reserved.length > 0) {
		throw new Error(`Post ids collide with reserved feed slugs: ${reserved.map((r) => r.id).join(', ')}`);
	}
	return [
		...tags.map((tag) => ({
			params: { slug: `tag/${slugify(tag)}` },
			props: { kind: 'feed' as const, tag, posts: posts.filter((post) => post.data.tags.includes(tag)) },
		})),
		...posts.map((post) => ({
			params: { slug: post.id },
			props: { kind: 'detail' as const, post },
		})),
	];
}

const props = Astro.props;
const pageTitle =
	props.kind === 'detail' ? props.post.data.title : props.kind === 'feed' ? `${props.tag} — Posts` : 'Posts';
// Global numbering: newest = highest, so a post keeps its number everywhere.
const all = (await getCollection('posts')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const noOf = new Map(all.map((post, i) => [post.id, all.length - i]));

const detail = props.kind === 'detail' ? props.post : null;
const { Content } = detail ? await render(detail) : { Content: null };

const detailDescription =
	'Notes from the T3NK partners — decision notes, engineering logs and signals from the edge of capital + code.';
const description = detail ? detail.data.desc : detailDescription;
// Build-time OG card (src/pages/og/[slug].png.ts), banner fallback elsewhere.
const image = detail ? asset(`/og/${detail.id}.png`) : undefined;

const siteURL = new URL('/', Astro.site).toString();
const schemaJSON = detail
	? JSON.stringify({
			'@context': 'https://schema.org',
			'@type': 'Article',
			headline: detail.data.title,
			description: detail.data.desc,
			datePublished: detail.data.date,
			author: { '@id': `${siteURL}#organization` },
			publisher: { '@id': `${siteURL}#organization` },
		})
	: null;
---

<Layout
	title={pageTitle}
	description={description}
	ogType={detail ? 'article' : 'website'}
	image={image}
	imageAlt={detail ? `${detail.data.title} — T3NK post card` : undefined}
>
	{schemaJSON && <script is:inline type="application/ld+json" set:html={schemaJSON} />}
	{
		props.kind === 'feed' && (
			<div class="posts-page">
				<div class="posts-head">
					<h1 class="posts-title">POSTS</h1>
					<p class="posts-sub">Tagged “{props.tag}”.</p>
					<PostsTabs active={slugify(props.tag)} />
				</div>
				<div class="posts-list">
					{props.posts.map((post) => (
						<PostRow post={post} no={noOf.get(post.id)} />
					))}
				</div>
			</div>
		)
	}

	{
		detail && (
			<article class="post">
				<div class="post-inner">
					<a href={url('posts')} class="post-back">
						← All posts
					</a>

					<h1 class="post-title">{detail.data.title}</h1>

					<div class="post-meta">
						{detail.data.date && <FormattedDate date={detail.data.date} />}
						{detail.data.tags.map((tag) => (
							<span class="post-tag">{tag}</span>
						))}
					</div>

					<p class="post-desc">{detail.data.desc}</p>

					{Content && (
						<div class="prose-basic post-body">
							<Content />
						</div>
					)}
				</div>
			</article>
		)
	}
</Layout>

<style>
	.posts-page {
		padding-top: 6rem;
		min-height: 100vh;
		background: var(--gray-50);
	}

	.posts-head {
		max-width: 56rem;
		margin: 0 auto 3rem;
		padding: 1.5rem 1.5rem 0;
	}

	.posts-title {
		font-size: 2.25rem;
		font-weight: 900;
		margin-bottom: 1rem;
		letter-spacing: -0.025em;
	}

	.posts-sub {
		font-size: 1.125rem;
		color: var(--gray-500);
		font-family: var(--font-mono);
	}

	.posts-list {
		max-width: 56rem;
		margin: 0 auto;
		padding: 0 1.5rem 6rem;
		display: grid;
		gap: 1rem;
	}

	/* Detail page */
	.post {
		background: var(--gray-50);
		padding-bottom: 8rem;
	}

	.post-inner {
		max-width: 56rem;
		margin: 0 auto;
		padding: 2.5rem 1.5rem 0;
	}

	.post-back {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--gray-500);
		transition: color 0.15s ease;
	}

	.post-back:hover {
		color: var(--black);
	}

	.post-title {
		font-size: 2.75rem;
		font-weight: 900;
		letter-spacing: -0.025em;
		margin: 2.5rem 0 1.5rem;
	}

	.post-meta {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--gray-500);
		margin-bottom: 1rem;
	}

	.post-meta .post-tag {
		text-transform: uppercase;
		letter-spacing: 0.05em;
		background: var(--white);
		border: 1px solid var(--gray-200);
		padding: 0.25rem 0.5rem;
		border-radius: 0.25rem;
		font-weight: 700;
	}

	.post-desc {
		font-size: 1.125rem;
		color: var(--gray-500);
		font-family: var(--font-mono);
		line-height: 1.625;
		max-width: 42rem;
		margin-bottom: 2.5rem;
		padding-bottom: 2.5rem;
		border-bottom: 1px solid var(--gray-200);
	}

	.post-body {
		color: var(--black);
	}

	@media (min-width: 768px) {
		.post-title {
			font-size: 4rem;
		}
	}
</style>
