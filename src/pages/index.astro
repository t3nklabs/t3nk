---
import Layout from '../layouts/Layout.astro';
import { asset } from '../consts';
import HeroSection from '../components/sections/HeroSection.astro';
import TechStackSection from '../components/sections/TechStackSection.astro';
import ManifestoSection from '../components/sections/ManifestoSection.astro';
import ServicesSection from '../components/sections/ServicesSection.astro';
import ProcessSection from '../components/sections/ProcessSection.astro';
import StandardsSection from '../components/sections/StandardsSection.astro';
import PostsSection from '../components/sections/PostsSection.astro';
