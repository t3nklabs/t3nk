---
// Detail page for a single work entry — both the project variant (card + body
// + related updates) and the update variant (changelog post).
import { render, type CollectionEntry } from 'astro:content';
import Icon from '../Icon.astro';
import FormattedDate from '../FormattedDate.astro';
import WorkCard from '../WorkCard.astro';
import { url } from '../../consts';
import { slugify } from '../../lib/work';

interface Props {
	entry: CollectionEntry<'work'>;
	/** Updates that reference this project (project pages only). */
	relatedUpdates: CollectionEntry<'work'>[];
	/** slug -> project title, to resolve update->project links. */
	projectTitles: Map<string, string>;
}

const { entry, relatedUpdates, projectTitles } = Astro.props;
const isProject = entry.data.kind === 'project';
const { Content } = await render(entry);
const projectTitle = entry.data.project ? projectTitles.get(entry.data.project) : undefined;
---

<article class="detail">
	<div class="detail-inner">
		<a href={url('work')} class="detail-back">← All work</a>

		<div class="detail-tags">
			{
				entry.data.tags.map((tag) => (
					<a href={url(`work/tag/${slugify(tag)}`)} class="detail-tag" aria-label={`More in ${tag}`}>
						{tag}
					</a>
				))
			}
		</div>

		<h1 class="detail-title">{entry.data.title}</h1>

		<p class="detail-desc">{entry.data.desc}</p>

		{
			isProject && entry.data.url && (
				<a href={entry.data.url} target="_blank" rel="noopener noreferrer" class="btn btn-solid detail-visit">
					VISIT PROJECT
					<Icon name="arrow-up-right" size={16} class="detail-visit-icon" />
				</a>
			)
		}

		{
			!isProject && (
				<div class="detail-meta">
					<span class="detail-update">
						UPDATE
						{entry.data.date && <FormattedDate date={entry.data.date} />}
					</span>
					{
						projectTitle && (
							<a href={url(`work/${entry.data.project}`)} class="detail-project">
								{projectTitle}
							</a>
						)
					}
				</div>
			)
		}

		{Content && <div class="prose-basic detail-body"><Content /></div>}

		{
			isProject && relatedUpdates.length > 0 && (
				<section class="detail-updates">
					<h2 class="detail-updates-heading">UPDATES</h2>
					<div class="detail-updates-grid">
						{relatedUpdates.map((update) => (
							<WorkCard entry={update} />
						))}
					</div>
				</section>
			)
		}
	</div>
</article>

<style>
	.detail {
		background: var(--gray-50);
		padding-bottom: 8rem;
	}

	.detail-inner {
		max-width: 56rem;
		margin: 0 auto;
		/* 6rem clears the fixed header — same spacer as the post detail. */
		padding: 6rem 1.5rem 0;
	}

	.detail-back {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--gray-500);
		transition: color 0.15s ease;
	}

	.detail-back:hover {
		color: var(--black);
	}

	.detail-tags {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		margin: 2.5rem 0 1.5rem;
	}

	/* Tag chip — breadcrumb into the tag feed (anchors, invert on hover). */
	.detail-tag {
		font-family: var(--font-mono);
		font-size: 0.625rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--gray-500);
		background: var(--white);
		border: 1px solid var(--gray-200);
		padding: 0.25rem 0.5rem;
		border-radius: 0.25rem;
		font-weight: 700;
	}

	a.detail-tag:hover {
		background: var(--black);
		border-color: var(--black);
		color: var(--white);
	}

	a.detail-tag:focus-visible {
		outline: 2px solid var(--black);
		outline-offset: 1px;
	}

	.detail-title {
		font-size: 3rem;
		font-weight: 900;
		letter-spacing: -0.025em;
		margin-bottom: 1.5rem;
	}

	.detail-desc {
		font-size: 1.125rem;
		color: var(--gray-500);
		font-family: var(--font-mono);
		margin-bottom: 2.5rem;
		max-width: 42rem;
		line-height: 1.625;
	}

	.detail-visit {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.75rem 1.5rem;
	}

	.detail-meta {
		display: flex;
		align-items: center;
		gap: 1rem;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--gray-500);
	}

	.detail-update {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
	}

	.detail-project {
		background: var(--white);
		border: 1px solid var(--gray-200);
		padding: 0.25rem 0.5rem;
		border-radius: 0.25rem;
		color: var(--gray-500);
		transition: border-color 0.15s ease, color 0.15s ease;
	}

	.detail-project:hover {
		border-color: var(--black);
		color: var(--black);
	}

	.detail-body {
		margin-top: 3rem;
		color: var(--black);
	}

	.detail-updates {
		margin-top: 5rem;
	}

	.detail-updates-heading {
		font-family: var(--font-mono);
		font-size: 0.875rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--gray-500);
		border-bottom: 1px solid var(--gray-200);
		padding-bottom: 1rem;
		margin-bottom: 2rem;
	}

	.detail-updates-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.5rem;
	}

	@media (min-width: 768px) {
		.detail-title {
			font-size: 4.5rem;
		}
		.detail-desc {
			font-size: 1.25rem;
		}
		.detail-updates-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
</style>
