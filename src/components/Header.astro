---
// Fixed static header, ported from t3nk-old App.vue.
import { url } from '../consts';

const links = [
	{ path: '', label: 'HOME' },
	{ path: 'about', label: 'ABOUT' },
	{ path: 'work', label: 'WORK' },
	{ path: 'team', label: 'TEAM' },
];

const current = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (path: string) => {
	const target = (url(path) ?? '/').replace(/\/+$/, '') || '/';
	return current === target;
};
---

<header class="fixed top-0 inset-x-0 z-50 bg-white/80 backdrop-blur-md border-b border-gray-100">
	<div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
		<a href={url()} class="text-xl font-black tracking-tighter bg-black text-white px-2 py-1">T3NK</a>

		<nav class="hidden md:flex items-center gap-8 font-mono text-sm font-medium">
			{
				links.map((link) => (
					<a
						href={url(link.path)}
						aria-current={isActive(link.path) ? 'page' : undefined}
						class:list={['transition-colors', isActive(link.path) ? 'border-b-2 border-black' : 'hover:text-gray-500']}
					>
						{link.label}
					</a>
				))
			}
			<a href={url('pitch')} class="bg-black text-white px-4 py-2 hover:bg-gray-800 transition-colors">
				PITCH US
			</a>
		</nav>

		<a href={url('pitch')} class="md:hidden text-sm font-bold border-b-2 border-black">
			PITCH US
		</a>
	</div>
</header>
