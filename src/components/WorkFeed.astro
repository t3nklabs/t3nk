---
// Tabbed work feed: ALL / PROJECTS / UPDATES / per-tag. Pure static — every
// tab is its own page, generated in pages/work/[...slug].astro.
import { url } from '../consts';
import { slugify, byOrder, byDateDesc } from '../lib/work';
import WorkCard from './WorkCard.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
	entries: CollectionEntry<'work'>[];
	/** 'all' | 'projects' | 'updates' | a slugified tag. */
	active: string;
}

const { entries, active } = Astro.props;

const tags = [...new Set(entries.flatMap((entry) => entry.data.tags))];
const projects = entries.filter((entry) => entry.data.kind === 'project').sort(byOrder);
const updates = entries.filter((entry) => entry.data.kind === 'update').sort(byDateDesc);
const projectTitleById = new Map(projects.map((project) => [project.id, project.data.title]));

const tabs = [
	{ label: 'All', href: url('work'), slug: 'all' },
	{ label: 'Projects', href: url('work/projects'), slug: 'projects' },
	{ label: 'Updates', href: url('work/updates'), slug: 'updates' },
	...tags.map((tag) => ({ label: tag, href: url(`work/tag/${slugify(tag)}`), slug: slugify(tag) })),
];

const feed =
	active === 'all'
		? [...projects, ...updates]
		: active === 'projects'
			? projects
			: active === 'updates'
				? updates
				: entries.filter((entry) => entry.data.tags.some((tag) => slugify(tag) === active));
---

<div class="max-w-7xl mx-auto px-6 pb-32">
	<!-- Tabs -->
	<div class="flex flex-wrap items-center justify-center gap-2 mb-12">
		{
			tabs.map((tab) => (
				<a
					href={tab.href}
					aria-current={tab.slug === active ? 'true' : undefined}
					class:list={[
						'font-mono text-xs uppercase tracking-widest px-4 py-2 rounded-full border transition-colors',
						tab.slug === active
							? 'bg-black text-white border-black'
							: 'border-gray-300 text-gray-600 hover:border-black hover:text-black',
					]}
				>
					{tab.label}
				</a>
			))
		}
	</div>

	<!-- Grid -->
	{
		feed.length ? (
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
				{feed.map((entry) => (
					<WorkCard
						entry={entry}
						projectTitle={entry.data.project ? projectTitleById.get(entry.data.project) : undefined}
					/>
				))}
			</div>
		) : (
			<div class="border border-gray-200 p-8 font-mono text-sm text-gray-500">Selected work will be listed here.</div>
		)
	}
</div>
