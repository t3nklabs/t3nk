---
// Tabbed work feed: ALL / PROJECTS / UPDATES / per-tag. Pure static — every
// tab is its own page, generated in pages/work/[...slug].astro.
import { url } from '../consts';
import { slugify, byOrder, byDateDesc } from '../lib/work';
import WorkCard from './WorkCard.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
	entries: CollectionEntry<'work'>[];
	/** 'all' | 'projects' | 'updates' | a slugified tag. */
	active: string;
}

const { entries, active } = Astro.props;

const tags = [...new Set(entries.flatMap((entry) => entry.data.tags))];
const projects = entries.filter((entry) => entry.data.kind === 'project').sort(byOrder);
const updates = entries.filter((entry) => entry.data.kind === 'update').sort(byDateDesc);
const projectTitleById = new Map(projects.map((project) => [project.id, project.data.title]));

const tabs = [
	{ label: 'All', href: url('work'), slug: 'all' },
	{ label: 'Projects', href: url('work/projects'), slug: 'projects' },
	{ label: 'Updates', href: url('work/updates'), slug: 'updates' },
	...tags.map((tag) => ({ label: tag, href: url(`work/tag/${slugify(tag)}`), slug: slugify(tag) })),
];

const feed =
	active === 'all'
		? [...projects, ...updates]
		: active === 'projects'
			? projects
			: active === 'updates'
				? updates
				: entries.filter((entry) => entry.data.tags.some((tag) => slugify(tag) === active));
---

<div class="container feed">
	<!-- Tabs -->
	<div class="feed-tabs">
		{
			tabs.map((tab) => (
				<a
					href={tab.href}
					aria-current={tab.slug === active ? 'true' : undefined}
					class:list={['feed-tab', { 'is-active': tab.slug === active }]}
				>
					{tab.label}
				</a>
			))
		}
	</div>

	<!-- Grid -->
	{
		feed.length ? (
			<div class="feed-grid">
				{feed.map((entry) => (
					<WorkCard
						entry={entry}
						projectTitle={entry.data.project ? projectTitleById.get(entry.data.project) : undefined}
					/>
				))}
			</div>
		) : (
			<div class="feed-empty">Selected work will be listed here.</div>
		)
	}
</div>

<style>
	.feed {
		padding-bottom: 8rem;
	}

	.feed-tabs {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		margin-bottom: 3rem;
	}

	.feed-tab {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		padding: 0.5rem 1rem;
		border-radius: 9999px;
		border: 1px solid var(--gray-300);
		color: var(--gray-600);
		transition: border-color 0.15s ease, color 0.15s ease, background-color 0.15s ease;
	}

	.feed-tab:hover {
		border-color: var(--black);
		color: var(--black);
	}

	.feed-tab.is-active {
		background: var(--black);
		color: var(--white);
		border-color: var(--black);
	}

	.feed-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.5rem;
	}

	.feed-empty {
		border: 1px solid var(--gray-200);
		padding: 2rem;
		font-family: var(--font-mono);
		font-size: 0.875rem;
		color: var(--gray-500);
	}

	@media (min-width: 768px) {
		.feed-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (min-width: 1024px) {
		.feed-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
</style>
