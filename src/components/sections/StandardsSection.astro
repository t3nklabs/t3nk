---
// Ported from t3nk-old StandardsSection.vue — engineering standards + terminal card.
import Icon from '../Icon.astro';

const standards = [
	'Architecture review',
	'Code review',
	'CI/CD and environments',
	'Observability and alerts',
	'Threat modeling',
	'Documentation',
];
---

<section id="standards" class="relative py-32 bg-gray-50 text-black px-6">
	<div class="max-w-7xl mx-auto">
		<div class="grid lg:grid-cols-2 gap-16 items-center mb-20">
			<div>
				<span class="font-mono text-sm tracking-wider uppercase text-white bg-black px-2 py-1">Engineering Standards</span>
				<h2 class="text-5xl font-sans font-black mt-6 mb-8 uppercase leading-tight">
					We build what<br />
					<span class="text-transparent bg-clip-text bg-gradient-to-r from-black to-gray-500">we back.</span>
				</h2>
				<div class="space-y-6 text-lg text-gray-700 font-sans">
					<p>Our engineers work in the same repository as your team. That changes what gets built and how.</p>
					<p>
						We review architecture before it hardens, review code before it ships, and leave documentation your
						team can use.
					</p>
					<p class="font-bold">No handoff. No black box.</p>
				</div>
			</div>

			<div class="bg-black text-white p-8 font-mono rounded-lg shadow-2xl overflow-hidden relative border border-gray-800">
				<div class="absolute top-0 left-0 right-0 h-8 bg-[#111] border-b border-gray-800 flex items-center px-4 gap-2">
					<div class="w-3 h-3 rounded-full bg-gray-700"></div>
					<div class="w-3 h-3 rounded-full bg-gray-700"></div>
					<div class="w-3 h-3 rounded-full bg-gray-700"></div>
					<span class="ml-4 text-xs text-gray-500">engineering-standards — zsh</span>
				</div>

				<div class="mt-8 space-y-6">
					<div class="text-gray-500 uppercase tracking-widest text-xs border-b border-gray-800 pb-2">
						// In the repo from day one
					</div>

					<ul class="space-y-3">
						{
							standards.map((item) => (
								<li class="flex items-start gap-3 text-sm text-gray-300">
									<Icon name="check" size={16} class="mt-0.5 text-green-500 shrink-0" aria-hidden="true" />
									<span>{item}</span>
								</li>
							))
						}
					</ul>

					<div class="text-gray-500 uppercase tracking-widest text-xs border-b border-gray-800 pb-2 pt-2">
						// What we don't do
					</div>

					<ul class="space-y-3 text-sm text-gray-500">
						<li>Ship a prototype and disappear.</li>
						<li>Sell an audit we should have done during the build.</li>
						<li>Guarantee outcomes we do not control.</li>
					</ul>
				</div>
			</div>
		</div>

		<div class="grid md:grid-cols-3 gap-8 mt-16">
			<div class="bg-white p-8 border border-gray-200 shadow-sm">
				<h3 class="font-bold font-sans text-xl mb-3 uppercase">Code you can own</h3>
				<p class="text-gray-600 text-sm leading-relaxed">
					Your team gets the architecture, documentation, and context to maintain the system without us.
				</p>
			</div>
			<div class="bg-white p-8 border border-gray-200 shadow-sm">
				<h3 class="font-bold font-sans text-xl mb-3 uppercase">Security from day one</h3>
				<p class="text-gray-600 text-sm leading-relaxed">
					Threat modeling and code review are part of the build, not a post-launch audit.
				</p>
			</div>
			<div class="bg-white p-8 border border-gray-200 shadow-sm">
				<h3 class="font-bold font-sans text-xl mb-3 uppercase">We stay involved</h3>
				<p class="text-gray-600 text-sm leading-relaxed">
					We work through the first scaling problems, not just the first release.
				</p>
			</div>
		</div>
	</div>
</section>
