---
// Ported from t3nk-old ProcessSection.vue — four-step dark timeline.
---

<section class="bg-neutral-950 py-24 px-6 relative overflow-hidden">
	<!-- Background element -->
	<div
		class="absolute inset-0 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-neutral-900/50 via-neutral-950/0 to-neutral-950/0 pointer-events-none"
	></div>

	<div class="max-w-7xl mx-auto relative z-10">
		<div class="mb-20">
			<h2 class="text-4xl md:text-5xl font-bold mb-6 text-white tracking-tight">FROM ZERO TO <br />REVENUE.</h2>
			<p class="text-neutral-400 max-w-2xl text-lg">
				We are engineers before we are investors. The process is built around getting software into users'
				hands.
			</p>
		</div>

		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 relative">
			<!-- Connecting Line (Desktop) -->
			<div class="hidden lg:block absolute top-12 left-0 w-full h-0.5 bg-gradient-to-r from-neutral-800 via-neutral-700 to-neutral-800 -z-10"></div>

			{
				[
					['01', 'Thesis', 'We pressure-test the problem, the market, and the technical approach before we invest.'],
					['02', 'Prototype', 'We build a working MVP with your team. The goal is a product early users can try, not a deck.'],
					['03', 'Harden', 'We put the fundamentals in place: tests, CI/CD, observability, security, and documentation.'],
					['04', 'Scale', 'We stay involved through hiring, fundraising, and the first scaling problems.'],
				].map(([num, title, desc]) => (
					<div class="group relative">
						<div class="w-24 h-24 bg-neutral-900 rounded-2xl border border-neutral-800 flex items-center justify-center mb-8 group-hover:border-white/40 group-hover:bg-neutral-900/80 transition-all duration-300 shadow-lg shadow-black/50">
							<span class="text-4xl font-mono font-bold text-neutral-700 group-hover:text-white transition-colors">{num}</span>
						</div>
						<h3 class="text-xl font-bold text-white mb-3">{title}</h3>
						<p class="text-neutral-500 text-sm leading-relaxed">{desc}</p>
					</div>
				))
			}
		</div>
	</div>
</section>
