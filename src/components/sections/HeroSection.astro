---
// Ported from t3nk-old HeroSection.vue. Scroll arrow SVG is inlined instead of lucide.
import { url } from '../../consts';
---

<section class="hero">
	<!-- Background Accents -->
	<div class="hero-glow hero-glow-yellow"></div>
	<div class="hero-glow hero-glow-orange"></div>

	<div class="hero-inner">
		<h1 class="hero-title">T3NK</h1>
		<p class="hero-slogan">WE FUND. WE BUILD.</p>
		<p class="hero-tag">The engineering-first VC</p>

		<div class="hero-copy">
			<p>We invest in early-stage software companies. Then our engineers join the repo and help you ship.</p>
			<p>Capital gets you started. Code gets you to revenue.</p>

			<div class="hero-card">
				<p class="hero-card-lead">Pre-seed to Series A. Software only.</p>
				<p class="hero-card-note">If the hard part is technical, we should talk.</p>
			</div>
		</div>

		<div class="hero-actions">
			<a href={url('pitch')} class="btn btn-solid">PITCH US</a>
			<a href={url('work')} class="btn btn-outline">SEE THE WORK</a>
		</div>

		<div class="hero-scroll">
			<div class="hero-scroll-hint">
				<span class="hero-scroll-label">SCROLL</span>
				<svg class="hero-scroll-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
				</svg>
			</div>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		overflow: hidden;
		background: var(--white);
		color: var(--black);
		padding: 6rem 1.5rem;
	}

	.hero-glow {
		position: absolute;
		border-radius: 50%;
		filter: blur(64px);
		pointer-events: none;
	}

	.hero-glow-yellow {
		top: 25%;
		left: 25%;
		width: 600px;
		height: 600px;
		background: rgba(253, 224, 71, 0.1);
		animation: pulse 8s cubic-bezier(0.4, 0, 0.6, 1) infinite;
	}

	.hero-glow-orange {
		bottom: 33%;
		right: 25%;
		width: 500px;
		height: 500px;
		background: rgba(251, 146, 60, 0.1);
		animation: pulse 12s cubic-bezier(0.4, 0, 0.6, 1) infinite;
	}

	@keyframes pulse {
		0%,
		100% {
			opacity: 0.5;
		}
		50% {
			opacity: 0.8;
		}
	}

	.hero-inner {
		max-width: 64rem;
		width: 100%;
		text-align: center;
		z-index: 10;
	}

	.hero-title {
		font-size: 11vw;
		line-height: 0.9;
		font-weight: 900;
		letter-spacing: -0.05em;
		margin-bottom: 0.75rem;
		color: var(--black);
	}

	/* Hollow wordmark: outlined "T3NK", with solid fallback */
	@supports (-webkit-text-stroke: 1px black) {
		.hero-title {
			color: transparent;
			/* Thinner outline on small type, so counters don't close up */
			-webkit-text-stroke: 0.025em var(--black);
		}
	}

	.hero-slogan {
		font-size: clamp(1.5rem, 4.5vw, 2.25rem);
		line-height: 1.1;
		font-weight: 900;
		letter-spacing: -0.03em;
		margin-bottom: 1.5rem;
		color: var(--black);
		animation: hero-rise 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.25s both;
	}

	/* Hollow mark resolves in first, slogan rises after it */
	.hero-title {
		animation: hero-fade 0.5s ease-out both;
	}

	@keyframes hero-fade {
		from {
			opacity: 0;
		}
	}

	@keyframes hero-rise {
		from {
			opacity: 0;
			transform: translateY(0.75rem);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-title,
		.hero-slogan,
		.hero-scroll {
			animation: none;
		}
	}

	.hero-tag {
		font-family: var(--font-mono);
		font-size: 1.125rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		margin-bottom: 3rem;
		display: inline-block;
		border-bottom: 2px solid var(--black);
		padding-bottom: 0.5rem;
	}

	.hero-copy {
		margin: 0 auto;
		max-width: 48rem;
		font-size: 1.125rem;
		color: #1f2937;
		line-height: 1.625;
	}

	.hero-copy > * + * {
		margin-top: 1.5rem;
	}

	.hero-card {
		margin-top: 2rem;
		padding: 1.5rem;
		background: var(--gray-50);
		border: 1px solid var(--gray-200);
		border-radius: 0.5rem;
		text-align: left;
	}

	.hero-card-lead {
		font-weight: 700;
	}

	.hero-card-note {
		font-family: var(--font-mono);
		font-size: 0.875rem;
		color: var(--gray-600);
		margin-top: 0.5rem;
	}

	.hero-actions {
		margin-top: 3rem;
		display: flex;
		flex-direction: column;
		gap: 1rem;
		justify-content: center;
	}

	.hero-scroll {
		margin-top: 4rem;
		display: flex;
		justify-content: center;
		animation: hero-fade 0.5s ease-out 0.7s both;
	}

	.hero-scroll-hint {
		animation: bounce 1s infinite;
		cursor: pointer;
	}

	@keyframes bounce {
		0%,
		100% {
			transform: translateY(-25%);
			animation-timing-function: cubic-bezier(0.8, 0, 1, 1);
		}
		50% {
			transform: translateY(0);
			animation-timing-function: cubic-bezier(0, 0, 0.2, 1);
		}
	}

	.hero-scroll-label {
		font-family: var(--font-mono);
		font-size: 0.875rem;
		letter-spacing: 0.1em;
	}

	.hero-scroll-arrow {
		width: 1.5rem;
		height: 1.5rem;
		margin: 0.5rem auto 0;
	}

	/* Small screens */
	@media (min-width: 640px) {
		.hero-title {
			font-size: 7vw;
		}
		@supports (-webkit-text-stroke: 1px black) {
			.hero-title {
				/* Bolder outline on large type, where it would otherwise look wispy */
				-webkit-text-stroke: 0.042em var(--black);
			}
		}
		.hero-tag {
			font-size: 1.25rem;
		}
		.hero-copy {
			font-size: 1.25rem;
		}
		.hero-actions {
			flex-direction: row;
		}
	}
</style>
