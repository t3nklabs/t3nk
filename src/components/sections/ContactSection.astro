---
// Ported from deer.capital's contact section (light, centered pitch block
// with stats row + embedded site footer). Replaces the dark two-card layout.
import Icon from '../Icon.astro';
import { url } from '../../consts';

const year = new Date().getFullYear();
---

<section id="contact" class="contact">
	<div class="contact-container">
		<!-- Brand mark stand-in for the deer.capital mascot -->
		<div class="contact-emblem">
			<Icon name="zap" size={60} />
		</div>

		<h2 class="contact-title">
			BUILDING<br />
			<span class="fade-text fade-text-light">SOMETHING BIG?</span>
		</h2>

		<a href={url('pitch')} class="contact-link">
			<span>&#9889; PITCH US</span>
			<span class="contact-link-mail">/pitch</span>
		</a>

		<p class="contact-note">
			// We respond to every founder. No deck required for first contact.
		</p>

		<p class="contact-alt">
			Prefer email? <a href="mailto:in@t3nk.com" class="contact-alt-link">in@t3nk.com</a>
		</p>

		<div class="contact-stats">
			<div>
				<div class="contact-stat-value">24</div>
				<div class="contact-stat-label">Portfolio Companies</div>
			</div>

			<div>
				<div class="contact-stat-value">$180M</div>
				<div class="contact-stat-label">Assets Under Management</div>
			</div>

			<div>
				<div class="contact-stat-value">12</div>
				<div class="contact-stat-label">Countries</div>
			</div>

			<div>
				<div class="contact-stat-value">3.2x</div>
				<div class="contact-stat-label">Avg. MOIC</div>
			</div>
		</div>
	</div>

	<footer class="contact-footer">
		t3nk.com &copy; {year}. ALL RIGHTS RESERVED.
	</footer>
</section>

<style>
	.contact {
		position: relative;
		padding: 8rem 1.5rem;
		background: var(--white);
		color: var(--black);
		text-align: center;
	}

	/* max-w-4xl mx-auto */
	.contact-container {
		max-width: 56rem;
		margin: 0 auto;
	}

	/* Mascot stand-in (deer.capital uses an emoji) */
	.contact-emblem {
		display: flex;
		justify-content: center;
		margin-bottom: 2rem;
	}

	.contact-emblem :global(svg) {
		color: var(--black);
	}

	/* text-6xl sm:text-8xl font-black tracking-tighter leading-none */
	.contact-title {
		font-size: 3.75rem;
		font-weight: 900;
		letter-spacing: -0.05em;
		line-height: 1;
		margin-bottom: 2rem;
	}

	/* Underlined mono pitch link, inverts on hover (bg + inline padding grow) */
	.contact-link {
		display: inline-flex;
		align-items: center;
		gap: 1rem;
		font-family: var(--font-mono);
		font-size: 1.5rem;
		font-weight: 700;
		border-bottom: 4px solid var(--black);
		padding: 0 0 0.5rem;
		transition: background-color 0.3s ease, color 0.3s ease, padding 0.3s ease;
	}

	.contact-link:hover {
		background: var(--black);
		color: var(--white);
		padding-left: 1rem;
		padding-right: 1rem;
	}

	.contact-link-mail {
		color: var(--gray-400);
		transition: color 0.3s ease;
	}

	.contact-link:hover .contact-link-mail {
		color: var(--white);
	}

	/* Mono aside under the link */
	.contact-note {
		margin-top: 2rem;
		font-size: 0.875rem;
		font-family: var(--font-mono);
		color: var(--gray-500);
	}

	/* Secondary channel below the aside — the primary CTA goes to /pitch */
	.contact-alt {
		margin-top: 0.75rem;
		font-size: 0.875rem;
		font-family: var(--font-mono);
		color: var(--gray-400);
	}

	.contact-alt-link {
		color: var(--gray-600);
		border-bottom: 2px solid var(--gray-300);
		transition: color 0.3s ease, border-color 0.3s ease;
	}

	.contact-alt-link:hover {
		color: var(--black);
		border-color: var(--black);
	}

	/* Stats / principles row */
	.contact-stats {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 2rem;
		margin-top: 5rem;
		padding-top: 3rem;
		border-top: 1px solid var(--gray-100);
	}

	/* Deer-style numeric stats — back to the template's text-3xl sizing. */
	.contact-stat-value {
		font-size: 1.875rem;
		font-weight: 700;
	}

	.contact-stat-label {
		font-size: 0.75rem;
		color: var(--gray-400);
		margin-top: 0.25rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
	}

	/* Embedded site footer strip */
	.contact-footer {
		position: absolute;
		bottom: 0;
		left: 0;
		width: 100%;
		padding: 1.5rem 0;
		text-align: center;
		border-top: 1px solid var(--gray-100);
		background: var(--gray-50);
		font-size: 0.75rem;
		color: var(--gray-400);
		font-family: var(--font-mono);
	}

	@media (min-width: 640px) {
		.contact-title {
			font-size: 6rem;
		}
		.contact-link {
			font-size: 2.25rem;
		}
	}

	@media (min-width: 768px) {
		.contact-stats {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
	}
</style>
