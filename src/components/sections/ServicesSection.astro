---
// Ported from t3nk-old ServicesSection.vue — hover-swap service grid.
import Icon from '../Icon.astro';
import type { IconName } from '../icons';
import { url } from '../../consts';

const services: { icon: IconName; title: string; desc: string; tags: string[] }[] = [
	{
		icon: 'code-2',
		title: 'PRODUCT ENGINEERING',
		desc: 'Web and mobile products, from first prototype to production.',
		tags: ['Vue', 'React', 'TypeScript', 'Node.js'],
	},
	{
		icon: 'brain',
		title: 'AI SYSTEMS',
		desc: 'LLM applications, agents, and evaluation pipelines that hold up in production.',
		tags: ['Python', 'LLM APIs', 'RAG', 'Evals'],
	},
	{
		icon: 'server',
		title: 'INFRASTRUCTURE',
		desc: 'Deployment, observability, and cost control for systems that have to stay up.',
		tags: ['Docker', 'Kubernetes', 'Terraform', 'Linux'],
	},
	{
		icon: 'shield-check',
		title: 'SECURITY',
		desc: 'Threat modeling, code review, and penetration testing before launch.',
		tags: ['OWASP', 'Auth', 'Encryption', 'Audits'],
	},
	{
		icon: 'database',
		title: 'DATA',
		desc: 'Pipelines, analytics, and the data model behind the product.',
		tags: ['PostgreSQL', 'Redis', 'Python', 'Analytics'],
	},
	{
		icon: 'users',
		title: 'TECHNICAL HIRING',
		desc: 'We define roles and interview the first engineers with you.',
		tags: ['Hiring', 'Architecture', 'Mentorship'],
	},
];
---

<section id="services" class="relative py-32 bg-white text-black px-6">
	<div class="max-w-7xl mx-auto">
		<div class="mb-20">
			<span class="font-mono text-sm tracking-wider uppercase text-gray-500">02 / Where we help</span>
			<h2 class="text-5xl font-sans font-black mt-4 mb-6">WHAT WE BUILD</h2>
			<p class="font-sans text-xl text-gray-600 max-w-2xl">
				We work inside your team on the parts that decide whether the product ships.
			</p>
		</div>

		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-px bg-gray-200 border border-gray-200">
			{
				services.map((service, index) => (
					<div class="bg-white p-8 group hover:bg-black hover:text-white transition-colors duration-300 min-h-[320px] flex flex-col justify-between">
						<div>
							<div class="flex justify-between items-start mb-8">
								<Icon name={service.icon} class="w-8 h-8" aria-hidden="true" />
								<span class="font-mono text-sm opacity-50">0{index + 1}</span>
							</div>
							<h3 class="font-sans font-bold text-xl mb-4 group-hover:text-white">{service.title}</h3>
							<p class="font-mono text-sm text-gray-600 mb-6 group-hover:text-gray-300 leading-relaxed">{service.desc}</p>
						</div>

						<div class="space-y-4">
							<div class="flex flex-wrap gap-2 text-xs font-mono">
								{service.tags.map((tag) => (
									<span class="border border-gray-200 px-2 py-1 rounded bg-gray-50 text-gray-600 group-hover:bg-gray-800 group-hover:text-gray-300 group-hover:border-gray-700">
										{tag}
									</span>
								))}
							</div>
							<div class="text-right opacity-0 group-hover:opacity-100 transition-opacity">
								<span class="text-2xl">→</span>
							</div>
						</div>
					</div>
				))
			}
		</div>

		<div class="mt-16 flex flex-col md:flex-row items-center justify-between bg-black text-white p-8">
			<div class="flex items-center gap-4 mb-6 md:mb-0">
				<span class="w-2 h-2 bg-white rounded-full"></span>
				<p class="font-mono font-bold">Every company we back gets our engineering team in the repo.</p>
			</div>
			<a
				href={url('pitch')}
				class="px-8 py-3 bg-white text-black font-bold font-mono hover:bg-gray-200 transition-colors uppercase"
			>
				Pitch your company →
			</a>
		</div>
	</div>
</section>
