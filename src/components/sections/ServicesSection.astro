---
// Ported from t3nk-old ServicesSection.vue — hover-swap service grid.
import Icon from '../Icon.astro';
import type { IconName } from '../icons';
import { url } from '../../consts';

const services: { icon: IconName; title: string; desc: string; tags: string[] }[] = [
	{
		icon: 'code-2',
		title: 'PRODUCT ENGINEERING',
		desc: 'Web and mobile products, from first prototype to production.',
		tags: ['Vue', 'React', 'TypeScript', 'Node.js'],
	},
	{
		icon: 'brain',
		title: 'AI SYSTEMS',
		desc: 'LLM applications, agents, and evaluation pipelines that hold up in production.',
		tags: ['Python', 'LLM APIs', 'RAG', 'Evals'],
	},
	{
		icon: 'server',
		title: 'INFRASTRUCTURE',
		desc: 'Deployment, observability, and cost control for systems that have to stay up.',
		tags: ['Docker', 'Kubernetes', 'Terraform', 'Linux'],
	},
	{
		icon: 'shield-check',
		title: 'SECURITY',
		desc: 'Threat modeling, code review, and penetration testing before launch.',
		tags: ['OWASP', 'Auth', 'Encryption', 'Audits'],
	},
	{
		icon: 'database',
		title: 'DATA',
		desc: 'Pipelines, analytics, and the data model behind the product.',
		tags: ['PostgreSQL', 'Redis', 'Python', 'Analytics'],
	},
	{
		icon: 'users',
		title: 'TECHNICAL HIRING',
		desc: 'We define roles and interview the first engineers with you.',
		tags: ['Hiring', 'Architecture', 'Mentorship'],
	},
];
---

<section id="services" class="services">
	<div class="container">
		<div class="services-head">
			<span class="eyebrow services-eyebrow">02 / Where we help</span>
			<h2 class="services-title">WHAT WE BUILD</h2>
			<p class="services-sub">We work inside your team on the parts that decide whether the product ships.</p>
		</div>

		<div class="services-grid">
			{
				services.map((service, index) => (
					<div class="service">
						<div>
							<div class="service-top">
								<span class="service-icon">
									<Icon name={service.icon} aria-hidden="true" />
								</span>
								<span class="service-index">{`0${index + 1}`}</span>
							</div>
							<h3 class="service-title">{service.title}</h3>
							<p class="service-desc">{service.desc}</p>
						</div>

						<div class="service-tags">
							<div class="service-pills">
								{service.tags.map((tag) => (
									<span class="service-pill">{tag}</span>
								))}
							</div>
							<div class="service-arrow">
								<span>→</span>
							</div>
						</div>
					</div>
				))
			}
		</div>

		<div class="services-banner">
			<div class="services-banner-copy">
				<span class="services-banner-dot"></span>
				<p>Every company we back gets our engineering team in the repo.</p>
			</div>
			<a href={url('pitch')} class="services-banner-cta">
				Pitch your company →
			</a>
		</div>
	</div>
</section>

<style>
	.services {
		position: relative;
		padding: 8rem 1.5rem;
		background: var(--white);
		color: var(--black);
	}

	.services-head {
		margin-bottom: 5rem;
	}

	.services-eyebrow {
		color: var(--gray-500);
		font-size: 0.875rem;
		letter-spacing: 0.05em;
	}

	.services-title {
		font-family: var(--font-sans);
		font-size: 3rem;
		font-weight: 900;
		margin: 1rem 0 1.5rem;
	}

	.services-sub {
		font-size: 1.25rem;
		color: var(--gray-600);
		max-width: 42rem;
	}

	/* 1px gaps rendered via background — gap-px trick */
	.services-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1px;
		background: var(--gray-200);
		border: 1px solid var(--gray-200);
	}

	.service {
		background: var(--white);
		padding: 2rem;
		min-height: 320px;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		transition: background-color 0.3s ease, color 0.3s ease;
	}

	.service-top {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		margin-bottom: 2rem;
	}

	.service-icon :global(svg) {
		width: 2rem;
		height: 2rem;
	}

	.service-index {
		font-family: var(--font-mono);
		font-size: 0.875rem;
		opacity: 0.5;
	}

	.service-title {
		font-weight: 700;
		font-size: 1.25rem;
		margin-bottom: 1rem;
	}

	.service-desc {
		font-family: var(--font-mono);
		font-size: 0.875rem;
		color: var(--gray-600);
		margin-bottom: 1.5rem;
		line-height: 1.625;
	}

	.service-tags > * + * {
		margin-top: 1rem;
	}

	.service-pills {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		font-size: 0.75rem;
		font-family: var(--font-mono);
	}

	.service-pill {
		border: 1px solid var(--gray-200);
		padding: 0.25rem 0.5rem;
		border-radius: 0.25rem;
		background: var(--gray-50);
		color: var(--gray-600);
		transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease;
	}

	.service-arrow {
		text-align: right;
		opacity: 0;
		transition: opacity 0.3s ease;
		font-size: 1.5rem;
	}

	.service .service-pill {
		border-color: var(--gray-200);
	}

	/* Hover swap to black */
	.service:hover {
		background: var(--black);
		color: var(--white);
	}

	.service:hover .service-title {
		color: var(--white);
	}

	.service:hover .service-desc {
		color: #d1d5db;
	}

	.service:hover .service-pill {
		background: var(--gray-800);
		color: #d1d5db;
		border-color: var(--gray-700);
	}

	.service:hover .service-arrow {
		opacity: 1;
	}

	.services-banner {
		margin-top: 4rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: space-between;
		background: var(--black);
		color: var(--white);
		padding: 2rem;
	}

	.services-banner-copy {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-bottom: 1.5rem;
	}

	.services-banner-dot {
		width: 0.5rem;
		height: 0.5rem;
		background: var(--white);
		border-radius: 50%;
		flex-shrink: 0;
	}

	.services-banner-copy p {
		font-family: var(--font-mono);
		font-weight: 700;
	}

	.services-banner-cta {
		padding: 0.75rem 2rem;
		background: var(--white);
		color: var(--black);
		font-weight: 700;
		font-family: var(--font-mono);
		transition: background-color 0.15s ease;
		text-transform: uppercase;
	}

	.services-banner-cta:hover {
		background: #e5e7eb;
	}

	/* Desktop */
	@media (min-width: 768px) {
		.services-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
		.services-banner {
			flex-direction: row;
		}
		.services-banner-copy {
			margin-bottom: 0;
		}
	}

	@media (min-width: 1024px) {
		.services-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
</style>
