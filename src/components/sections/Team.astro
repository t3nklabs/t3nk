---
// Ported from t3nk-old Team.vue — grayscale photo grid of the builders.
import { asset } from '../../consts';

const members = [
	{
		src: '/team/aman.png',
		alt: 'Aman Singh',
		role: 'CEO & Founder',
		desc: 'Founder and product engineer. Leads investments and works with portfolio companies on product, mobile, and the first version.',
	},
	{
		src: '/team/himanshu.png',
		alt: 'Himanshu',
		role: 'Project Manager',
		desc: 'Runs delivery across portfolio companies. Keeps engineering, hiring, and timelines aligned.',
	},
	{
		src: '/team/andrew.jpg',
		alt: 'Andrew',
		role: 'Senior Software Engineer',
		desc: 'Backend and platform engineer. Builds APIs, data pipelines, and the core systems behind portfolio products.',
	},
	{
		src: '/team/jamei.jpg',
		alt: 'Jamei',
		role: 'Product Designer',
		desc: 'Designs product experiences and interfaces. Turns user research into shipped, usable software.',
	},
	{
		src: '/team/tuje.jpg',
		alt: 'Tuje',
		role: 'Operations Lead',
		desc: 'Runs hiring, finance, and portfolio ops. Keeps the fund and its companies moving.',
	},
];
---

<section id="team" class="team">
	<div class="container">
		<div class="team-head">
			<span class="eyebrow team-eyebrow">03 / The team</span>
			<h2 class="team-title">THE BUILDERS</h2>
			<p class="team-sub">A small team of engineers and operators. We work inside the companies we back.</p>
		</div>

		<div class="team-grid">
			{
				members.map((member) => (
					<div class="team-member">
						<div class="team-member-photo">
							<img src={asset(member.src)} alt={member.alt} class="team-member-img" loading="lazy" decoding="async" />
							<div class="team-member-shade"></div>
						</div>

						<div>
							<div class="team-member-head">
								<h3 class="team-member-name">{member.alt}</h3>
							</div>
							<p class="team-member-role">{member.role}</p>
							<p class="team-member-desc">{member.desc}</p>
						</div>
					</div>
				))
			}
		</div>
	</div>
</section>

<style>
	.team {
		position: relative;
		padding: 8rem 1.5rem;
		background: var(--white);
		color: var(--black);
	}

	.team-eyebrow {
		color: var(--gray-500);
		font-size: 0.875rem;
		letter-spacing: 0.05em;
	}

	.team-title {
		font-family: var(--font-sans);
		font-size: 3rem;
		font-weight: 900;
		margin: 1rem 0 1.5rem;
	}

	.team-sub {
		font-size: 1.25rem;
		color: var(--gray-600);
		max-width: 42rem;
	}

	.team-head {
		margin-bottom: 5rem;
	}

	.team-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 3rem;
	}

	/* Reveal color photo on hover */
	.team-member-photo {
		position: relative;
		overflow: hidden;
		margin-bottom: 1.5rem;
		background: var(--gray-100);
		aspect-ratio: 3 / 4;
	}

	.team-member-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		filter: grayscale(100%);
		transition: filter 0.5s ease;
	}

	.team-member:hover .team-member-img {
		filter: grayscale(0);
	}

	.team-member-shade {
		position: absolute;
		inset: 0;
		background: rgba(0, 0, 0, 0.1);
		transition: background-color 0.3s ease;
	}

	.team-member:hover .team-member-shade {
		background: transparent;
	}

	.team-member-head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		margin-bottom: 0.5rem;
	}

	.team-member-name {
		font-weight: 700;
		font-size: 1.5rem;
		text-transform: uppercase;
	}

	.team-member-role {
		font-family: var(--font-mono);
		font-size: 0.875rem;
		color: var(--gray-500);
		text-transform: uppercase;
		letter-spacing: 0.05em;
		margin-bottom: 1rem;
		border-bottom: 1px solid var(--gray-200);
		padding-bottom: 1rem;
	}

	.team-member-desc {
		color: var(--gray-600);
		line-height: 1.625;
	}

	@media (min-width: 768px) {
		.team-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (min-width: 1024px) {
		.team-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
</style>
