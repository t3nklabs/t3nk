---
// Ported from t3nk-old Team.vue — grayscale photo grid of the builders.
// Members are data now: one markdown file per person in src/content/team/.
import { render, getCollection } from 'astro:content';
import { url, asset } from '../../consts';
import { byOrder } from '../../lib/work';

const members = (await getCollection('team')).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
---

<section id="team" class="team">
	<div class="container">
		<div class="team-head">
			<span class="eyebrow team-eyebrow">03 / The team</span>
			<h2 class="team-title">THE BUILDERS</h2>
			<p class="team-sub">A small team of engineers and operators. We work inside the companies we back.</p>
		</div>

		<div class="team-grid">
			{
				members.map((member) => (
					<a href={url(`team/${member.id}`)} class="team-member" aria-label={`${member.data.name} — ${member.data.role}`}>
						<div class="team-member-photo">
							<img src={asset(member.data.photo)} alt={member.data.name} class="team-member-img" loading="lazy" decoding="async" />
							<div class="team-member-shade"></div>
							<span class="team-member-view">PROFILE →</span>
						</div>

						<div>
							<div class="team-member-head">
								<h3 class="team-member-name">{member.data.name}</h3>
							</div>
							<p class="team-member-role">{member.data.role}</p>
							<p class="team-member-desc">{member.data.desc}</p>
						</div>
					</a>
				))
			}
		</div>
	</div>
</section>

<style>
	.team {
		position: relative;
		padding: 8rem 1.5rem;
		background: var(--white);
		color: var(--black);
	}

	.team-eyebrow {
		color: var(--gray-500);
		font-size: 0.875rem;
		letter-spacing: 0.05em;
	}

	.team-title {
		font-family: var(--font-sans);
		font-size: 3rem;
		font-weight: 900;
		margin: 1rem 0 1.5rem;
	}

	.team-sub {
		font-size: 1.25rem;
		color: var(--gray-600);
		max-width: 42rem;
	}

	.team-head {
		margin-bottom: 5rem;
	}

	.team-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 3rem;
	}

	/* Reveal color photo on hover */
	.team-member-photo {
		position: relative;
		overflow: hidden;
		margin-bottom: 1.5rem;
		background: var(--gray-100);
		aspect-ratio: 3 / 4;
	}

	.team-member-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		filter: grayscale(100%);
		transition: filter 0.5s ease;
	}

	.team-member:hover .team-member-img {
		filter: grayscale(0);
	}

	.team-member-shade {
		position: absolute;
		inset: 0;
		background: rgba(0, 0, 0, 0.1);
		transition: background-color 0.3s ease;
	}

	.team-member:hover .team-member-shade {
		background: transparent;
	}

	.team-member-view {
		position: absolute;
		top: 1rem;
		right: 1rem;
		font-family: var(--font-mono);
		font-size: 0.625rem;
		letter-spacing: 0.1em;
		color: var(--white);
		background: var(--black);
		padding: 0.35rem 0.6rem;
		border-radius: 0.25rem;
		opacity: 0;
		transition: opacity 0.3s ease;
		z-index: 2;
	}

	.team-member:hover .team-member-view {
		opacity: 1;
	}

	.team-member {
		display: block;
		color: inherit;
		text-decoration: none;
	}

	.team-member-head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		margin-bottom: 0.5rem;
	}

	.team-member-name {
		font-weight: 700;
		font-size: 1.5rem;
		text-transform: uppercase;
	}

	.team-member-role {
		font-family: var(--font-mono);
		font-size: 0.875rem;
		color: var(--gray-500);
		text-transform: uppercase;
		letter-spacing: 0.05em;
		margin-bottom: 1rem;
		border-bottom: 1px solid var(--gray-200);
		padding-bottom: 1rem;
	}

	.team-member-desc {
		color: var(--gray-600);
		line-height: 1.625;
	}

	@media (min-width: 768px) {
		.team-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (min-width: 1024px) {
		.team-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			max-width: 48rem;
			margin-left: auto;
			margin-right: auto;
		}
	}
</style>
