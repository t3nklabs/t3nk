---
// Ported from t3nk-old Team.vue — grayscale photo grid of the builders.
import { asset } from '../../consts';
---

<section id="team" class="relative py-32 bg-white text-black px-6">
	<div class="max-w-7xl mx-auto">
		<div class="mb-20">
			<span class="font-mono text-sm tracking-wider uppercase text-gray-500">03 / The team</span>
			<h2 class="text-5xl font-sans font-black mt-4 mb-6">THE BUILDERS</h2>
			<p class="font-sans text-xl text-gray-600 max-w-2xl">
				A small team of engineers and operators. We work inside the companies we back.
			</p>
		</div>

		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-12">
			<div class="group">
				<div class="relative overflow-hidden mb-6 bg-gray-100 aspect-[3/4]">
					<img
						src={asset('/team/naman.png')}
						alt="Naman"
						class="w-full h-full object-cover filter grayscale group-hover:grayscale-0 transition-all duration-500"
					/>
					<div class="absolute inset-0 bg-black/10 group-hover:bg-transparent transition-colors"></div>
				</div>

				<div>
					<div class="flex justify-between items-baseline mb-2">
						<h3 class="font-sans font-bold text-2xl uppercase">Naman</h3>
					</div>
					<p class="font-mono text-sm text-gray-500 uppercase tracking-wider mb-4 border-b border-gray-200 pb-4">CEO &amp; Founder</p>
					<p class="font-sans text-gray-600 leading-relaxed">
						Founder and product engineer. Leads investments and works with portfolio companies on product, mobile,
						and the first version.
					</p>
				</div>
			</div>

			<div class="group">
				<div class="relative overflow-hidden mb-6 bg-gray-100 aspect-[3/4]">
					<img
						src={asset('/team/aman.png')}
						alt="Aman Singh"
						class="w-full h-full object-cover filter grayscale group-hover:grayscale-0 transition-all duration-500"
					/>
					<div class="absolute inset-0 bg-black/10 group-hover:bg-transparent transition-colors"></div>
				</div>

				<div>
					<div class="flex justify-between items-baseline mb-2">
						<h3 class="font-sans font-bold text-2xl uppercase">Aman Singh</h3>
					</div>
					<p class="font-mono text-sm text-gray-500 uppercase tracking-wider mb-4 border-b border-gray-200 pb-4">Senior Software Developer</p>
					<p class="font-sans text-gray-600 leading-relaxed">
						Infrastructure and automation engineer. Builds deployment, observability, and the systems that keep
						products running.
					</p>
				</div>
			</div>

			<div class="group">
				<div class="relative overflow-hidden mb-6 bg-gray-100 aspect-[3/4]">
					<img
						src={asset('/team/himanshu.png')}
						alt="Himanshu"
						class="w-full h-full object-cover filter grayscale group-hover:grayscale-0 transition-all duration-500"
					/>
					<div class="absolute inset-0 bg-black/10 group-hover:bg-transparent transition-colors"></div>
				</div>

				<div>
					<div class="flex justify-between items-baseline mb-2">
						<h3 class="font-sans font-bold text-2xl uppercase">Himanshu</h3>
					</div>
					<p class="font-mono text-sm text-gray-500 uppercase tracking-wider mb-4 border-b border-gray-200 pb-4">Project Manager</p>
					<p class="font-sans text-gray-600 leading-relaxed">
						Runs delivery across portfolio companies. Keeps engineering, hiring, and timelines aligned.
					</p>
				</div>
			</div>
		</div>
	</div>
</section>
