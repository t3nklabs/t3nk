---
// Ported from t3nk-old ManifestoSection.vue — static dark section.
const tenets = [
	['01.', 'Revenue > Valuation', 'We optimize for customers and cash flow, not the next round.'],
	['02.', 'Shipping > Slides', 'Progress is a working product in front of real users, not a roadmap.'],
	['03.', 'Durability > Burn', 'We build systems a small team can run. Technology should be an asset, not a liability.'],
];
---

<section class="manifesto">
	<div class="container">
		<div class="manifesto-grid">
			<!-- Left: The Statement -->
			<div>
				<h2 class="manifesto-title">
					LESS NARRATIVE.<br />
					<span class="manifesto-muted">MORE SOFTWARE.</span>
				</h2>
				<p class="manifesto-text">
					Venture rewards the story more often than the system. We do the opposite: we invest in teams that
					ship, then work with them to ship better.
				</p>
				<p class="manifesto-text manifesto-text-gap">
					We are engineers before we are investors. That shapes who we back and how we spend our time.
				</p>
			</div>

			<!-- Right: The Core Tenets -->
			<div class="manifesto-tenets">
				{
					tenets.map(([num, title, desc]) => (
						<div class="manifesto-tenet">
							<h3 class="manifesto-tenet-title">
								<span class="manifesto-tenet-num">{num}</span>
								{title}
							</h3>
							<p class="manifesto-tenet-desc">{desc}</p>
						</div>
					))
				}
			</div>
		</div>
	</div>
</section>

<style>
	.manifesto {
		background: var(--black);
		color: var(--white);
		padding: 6rem 1.5rem;
		border-top: 1px solid var(--neutral-800);
		border-bottom: 1px solid var(--neutral-800);
	}

	.manifesto-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 4rem;
		align-items: start;
	}

	.manifesto-title {
		font-size: 2.25rem;
		font-weight: 900;
		letter-spacing: -0.05em;
		margin-bottom: 2rem;
		line-height: 1.25;
	}

	.manifesto-muted {
		color: #737373;
	}

	.manifesto-text {
		color: #a3a3a3;
		font-size: 1.125rem;
		line-height: 1.625;
		max-width: 36rem;
	}

	.manifesto-text-gap {
		margin-top: 1.5rem;
	}

	.manifesto-tenets > * + * {
		margin-top: 2rem;
	}

	.manifesto-tenet {
		border-left: 2px solid var(--neutral-800);
		padding-left: 1.5rem;
		transition: border-color 0.3s ease;
	}

	.manifesto-tenet-title {
		font-size: 1.5rem;
		font-weight: 700;
		margin-bottom: 0.5rem;
		transition: color 0.3s ease;
	}

	.manifesto-tenet-num {
		color: #525252;
		margin-right: 0.5rem;
		transition: color 0.3s ease;
	}

	.manifesto-tenet-desc {
		color: #737373;
		transition: color 0.3s ease;
	}

	.manifesto-tenet:hover {
		border-left-color: var(--white);
	}

	.manifesto-tenet:hover .manifesto-tenet-title,
	.manifesto-tenet:hover .manifesto-tenet-num {
		color: var(--white);
	}

	.manifesto-tenet:hover .manifesto-tenet-desc {
		color: #d4d4d4;
	}

	@media (min-width: 768px) {
		.manifesto-title {
			font-size: 3.75rem;
		}
	}

	@media (min-width: 1024px) {
		.manifesto-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
		.manifesto-text {
			font-size: 1.25rem;
		}
	}
</style>
