---
// Ported from t3nk-old ManifestoSection.vue — static dark section.
---

<section class="bg-black text-white py-24 px-6 md:px-12 border-y border-neutral-900">
	<div class="max-w-7xl mx-auto">
		<div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
			<!-- Left: The Statement -->
			<div>
				<h2 class="text-4xl md:text-6xl font-black tracking-tighter mb-8 leading-tight">
					LESS NARRATIVE.<br />
					<span class="text-neutral-500">MORE SOFTWARE.</span>
				</h2>
				<p class="text-neutral-400 text-lg md:text-xl leading-relaxed max-w-xl">
					Venture rewards the story more often than the system. We do the opposite: we invest in teams that
					ship, then work with them to ship better.
				</p>
				<p class="text-neutral-400 text-lg md:text-xl leading-relaxed max-w-xl mt-6">
					We are engineers before we are investors. That shapes who we back and how we spend our time.
				</p>
			</div>

			<!-- Right: The Core Tenets -->
			<div class="space-y-8">
				{
					[
						['01.', 'Revenue > Valuation', 'We optimize for customers and cash flow, not the next round.'],
						['02.', 'Shipping > Slides', 'Progress is a working product in front of real users, not a roadmap.'],
						['03.', 'Durability > Burn', 'We build systems a small team can run. Technology should be an asset, not a liability.'],
					].map(([num, title, desc]) => (
						<div class="group border-l-2 border-neutral-800 pl-6 hover:border-white transition-colors duration-300">
							<h3 class="text-2xl font-bold mb-2 group-hover:text-white transition-colors">
								<span class="text-neutral-600 group-hover:text-white mr-2 transition-colors">{num}</span>
								{title}
							</h3>
							<p class="text-neutral-500 group-hover:text-neutral-300 transition-colors">{desc}</p>
						</div>
					))
				}
			</div>
		</div>
	</div>
</section>
