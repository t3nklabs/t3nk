---
// Ported from t3nk-old TechStackSection.vue — two seamless marquees of
// simpleicons CDN logos, edge-fade mask, pause on hover.
const row1 = [
	{ name: 'Rust', slug: 'rust' },
	{ name: 'Go', slug: 'go' },
	{ name: 'Python', slug: 'python' },
	{ name: 'TypeScript', slug: 'typescript' },
	{ name: 'Docker', slug: 'docker' },
	{ name: 'Kubernetes', slug: 'kubernetes' },
	{ name: 'Terraform', slug: 'terraform' },
	{ name: 'Bitcoin', slug: 'bitcoin' },
	{ name: 'Linux', slug: 'linux' },
];

const row2 = [
	{ name: 'PostgreSQL', slug: 'postgresql' },
	{ name: 'Redis', slug: 'redis' },
	{ name: 'Nginx', slug: 'nginx' },
	{ name: 'Ansible', slug: 'ansible' },
	{ name: 'Prometheus', slug: 'prometheus' },
	{ name: 'Grafana', slug: 'grafana' },
	{ name: 'Vue.js', slug: 'vuedotjs' },
	{ name: 'React', slug: 'react' },
];
---

<section class="stack">
	<div class="stack-head">
		<span class="eyebrow stack-eyebrow">How we build</span>
		<h2 class="stack-title">THE STACK</h2>
		<p class="stack-sub">The tools we use to build and run what we back.</p>
	</div>

	{
		[row1, row2].map((row, i) => (
			<div class:list={['marquee', i === 0 && 'marquee-gap']}>
				<div class:list={['marquee-track', i === 0 ? 'scroll-left' : 'scroll-right']}>
					{row.map((tech) => (
						<div class="tech">
							<img src={`https://cdn.simpleicons.org/${tech.slug}/000000`} alt={tech.name} class="tech-logo" />
							<span class="tech-name">{tech.name}</span>
						</div>
					))}
					{/* Duplicate for seamless loop */}
					{row.map((tech) => (
						<div class="tech" aria-hidden="true">
							<img src={`https://cdn.simpleicons.org/${tech.slug}/000000`} alt="" class="tech-logo" />
							<span class="tech-name">{tech.name}</span>
						</div>
					))}
				</div>
			</div>
		))
	}
</section>

<style>
	.stack {
		padding: 6rem 0;
		background: var(--white);
		border-bottom: 1px solid var(--gray-100);
		overflow: hidden;
	}

	.stack-head {
		max-width: 80rem;
		margin: 0 auto 3rem;
		padding: 0 1.5rem;
		text-align: center;
	}

	.stack-eyebrow {
		color: var(--gray-400);
		font-size: 0.875rem;
		letter-spacing: 0.1em;
	}

	.stack-title {
		font-size: 1.875rem;
		font-weight: 900;
		margin: 1rem 0;
		color: var(--black);
		letter-spacing: -0.025em;
	}

	.stack-sub {
		font-family: var(--font-mono);
		font-size: 0.875rem;
		color: var(--gray-500);
	}

	.marquee {
		width: 100%;
		overflow: hidden;
		position: relative;
		/* Fade mask on sides */
		mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
		-webkit-mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
	}

	.marquee-gap {
		margin-bottom: 2rem;
	}

	.marquee-track {
		display: flex;
		gap: 4rem; /* Spacing between logos */
		width: max-content;
	}

	@keyframes scroll-left {
		0% {
			transform: translateX(0);
		}
		100% {
			transform: translateX(-50%);
		}
	}

	@keyframes scroll-right {
		0% {
			transform: translateX(-50%);
		}
		100% {
			transform: translateX(0);
		}
	}

	.scroll-left {
		animation: scroll-left 30s linear infinite;
	}

	.scroll-right {
		animation: scroll-right 30s linear infinite;
	}

	/* Pause on hover for easier viewing */
	.marquee:hover .marquee-track {
		animation-play-state: paused;
	}

	.tech {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 1rem;
	}

	.tech-logo {
		height: 3rem;
		width: 3rem;
		opacity: 0.4;
		filter: grayscale(100%);
		transition: opacity 0.3s ease, filter 0.3s ease;
	}

	.tech:hover .tech-logo {
		opacity: 1;
		filter: grayscale(0);
	}

	.tech-name {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		margin-top: 0.5rem;
		opacity: 0;
		transition: opacity 0.3s ease;
		position: absolute;
		bottom: -1.5rem;
		left: 50%;
		transform: translateX(-50%);
		white-space: nowrap;
		background: var(--black);
		color: var(--white);
		padding: 0.125rem 0.5rem;
		border-radius: 0.25rem;
	}

	.tech:hover .tech-name {
		opacity: 1;
	}

	@media (min-width: 768px) {
		.stack-title {
			font-size: 3rem;
		}
	}
</style>
