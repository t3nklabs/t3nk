---
// Ported from t3nk-old TechStackSection.vue — two seamless marquees of
// simpleicons CDN logos, edge-fade mask, pause on hover.
const row1 = [
	{ name: 'Rust', slug: 'rust' },
	{ name: 'Go', slug: 'go' },
	{ name: 'Python', slug: 'python' },
	{ name: 'TypeScript', slug: 'typescript' },
	{ name: 'Docker', slug: 'docker' },
	{ name: 'Kubernetes', slug: 'kubernetes' },
	{ name: 'Terraform', slug: 'terraform' },
	{ name: 'Bitcoin', slug: 'bitcoin' },
	{ name: 'Linux', slug: 'linux' },
];

const row2 = [
	{ name: 'PostgreSQL', slug: 'postgresql' },
	{ name: 'Redis', slug: 'redis' },
	{ name: 'Nginx', slug: 'nginx' },
	{ name: 'Ansible', slug: 'ansible' },
	{ name: 'Prometheus', slug: 'prometheus' },
	{ name: 'Grafana', slug: 'grafana' },
	{ name: 'Tailwind', slug: 'tailwindcss' },
	{ name: 'Vue.js', slug: 'vuedotjs' },
	{ name: 'React', slug: 'react' },
];
---

<section class="py-24 bg-white border-b border-gray-100 overflow-hidden">
	<div class="max-w-7xl mx-auto px-6 mb-12 text-center">
		<span class="font-mono text-sm tracking-widest uppercase text-gray-400">How we build</span>
		<h2 class="text-3xl md:text-5xl font-black mt-4 mb-4 text-black tracking-tight">THE STACK</h2>
		<p class="font-mono text-sm text-gray-500">The tools we use to build and run what we back.</p>
	</div>

	{
		[row1, row2].map((row, i) => (
			<div class:list={['marquee-container', i === 0 && 'mb-8']}>
				<div class:list={['marquee-content', i === 0 ? 'animate-scroll-left' : 'animate-scroll-right']}>
					{row.map((tech) => (
						<div class="tech-item group">
							<img src={`https://cdn.simpleicons.org/${tech.slug}/000000`} alt={tech.name} class="h-12 w-12 opacity-40 group-hover:opacity-100 transition-opacity duration-300 grayscale group-hover:grayscale-0" />
							<span class="font-mono text-xs mt-2 opacity-0 group-hover:opacity-100 transition-opacity duration-300 absolute -bottom-6 left-1/2 -translate-x-1/2 whitespace-nowrap bg-black text-white px-2 py-0.5 rounded">
								{tech.name}
							</span>
						</div>
					))}
					{/* Duplicate for seamless loop */}
					{row.map((tech) => (
						<div class="tech-item group" aria-hidden="true">
							<img src={`https://cdn.simpleicons.org/${tech.slug}/000000`} alt="" class="h-12 w-12 opacity-40 group-hover:opacity-100 transition-opacity duration-300 grayscale group-hover:grayscale-0" />
							<span class="font-mono text-xs mt-2 opacity-0 group-hover:opacity-100 transition-opacity duration-300 absolute -bottom-6 left-1/2 -translate-x-1/2 whitespace-nowrap bg-black text-white px-2 py-0.5 rounded">
								{tech.name}
							</span>
						</div>
					))}
				</div>
			</div>
		))
	}
</section>

<style>
	.marquee-container {
		width: 100%;
		overflow: hidden;
		position: relative;
		/* Fade mask on sides */
		mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
		-webkit-mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
	}

	.marquee-content {
		display: flex;
		gap: 4rem; /* Spacing between logos */
		width: max-content;
	}

	.tech-item {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 1rem;
	}

	@keyframes scroll-left {
		0% {
			transform: translateX(0);
		}
		100% {
			transform: translateX(-50%);
		}
	}

	@keyframes scroll-right {
		0% {
			transform: translateX(-50%);
		}
		100% {
			transform: translateX(0);
		}
	}

	.animate-scroll-left {
		animation: scroll-left 30s linear infinite;
	}

	.animate-scroll-right {
		animation: scroll-right 30s linear infinite;
	}

	/* Pause on hover for easier viewing */
	.marquee-container:hover .marquee-content {
		animation-play-state: paused;
	}
</style>
