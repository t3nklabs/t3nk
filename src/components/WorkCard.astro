---
// Card for a work entry (project or update), ported from t3nk-old
// ProjectsSection.vue — but linking internally to /work/<slug>.
import Icon from './Icon.astro';
import FormattedDate from './FormattedDate.astro';
import { url } from '../consts';
import type { CollectionEntry } from 'astro:content';

interface Props {
	entry: CollectionEntry<'work'>;
	/** Resolved title of `entry.data.project`, for update cards. */
	projectTitle?: string;
}

const { entry, projectTitle } = Astro.props;
const isProject = entry.data.kind === 'project';
const primaryBadge = isProject ? (entry.data.tags[0] ?? 'PROJECT') : 'UPDATE';
---

<a href={url(`work/${entry.id}`)} class="work-card">
	<!-- Top Row: Mark and Link -->
	<div class="work-card-top">
		<div class="work-card-mark">
			<span class="work-card-mark-letter">{entry.data.title.charAt(0)}</span>
		</div>
		<Icon name="arrow-up-right" size={20} class="work-card-arrow" aria-hidden="true" />
	</div>

	<!-- Title -->
	<h3 class="work-card-title">{entry.data.title}</h3>

	<!-- Description -->
	<p class="work-card-desc">{entry.data.desc}</p>

	<!-- Bottom Row: badge + meta -->
	<div class="work-card-meta">
		<div class="work-card-meta-left">
			<span class="work-card-badge">{primaryBadge}</span>
			{
				!isProject && entry.data.date && <FormattedDate date={entry.data.date} />
			}
			{
				!isProject && projectTitle && (
					<span class="work-card-project">{projectTitle}</span>
				)
			}
		</div>
		<span class="work-card-view">View</span>
	</div>
</a>

<style>
	.work-card {
		position: relative;
		padding: 2rem;
		background: var(--white);
		border: 1px solid var(--gray-100);
		border-radius: 1rem;
		display: flex;
		flex-direction: column;
		height: 100%;
		cursor: pointer;
		transition: border-color 0.5s ease, transform 0.5s ease, box-shadow 0.5s ease;
	}

	.work-card:hover {
		border-color: var(--black);
		box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
		transform: translateY(-0.5rem);
	}

	.work-card-top {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		margin-bottom: 1.5rem;
	}

	.work-card-mark {
		width: 3rem;
		height: 3rem;
		background: var(--gray-50);
		border-radius: 0.75rem;
		display: flex;
		align-items: center;
		justify-content: center;
		transition: background-color 0.5s ease, color 0.5s ease;
	}

	.work-card-mark-letter {
		font-weight: 700;
		font-size: 1.125rem;
	}

	.work-card-arrow {
		color: var(--gray-300);
		transition: color 0.5s ease;
	}

	.work-card:hover .work-card-mark {
		background: var(--black);
		color: var(--white);
	}

	.work-card:hover .work-card-arrow {
		color: var(--black);
	}

	.work-card-title {
		font-size: 1.25rem;
		font-weight: 700;
		font-family: var(--font-sans);
		margin-bottom: 0.75rem;
		color: var(--black);
	}

	.work-card-desc {
		font-size: 0.875rem;
		color: var(--gray-500);
		line-height: 1.625;
		font-family: var(--font-sans);
		margin-bottom: 1.5rem;
		flex-grow: 1;
	}

	.work-card-meta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-top: auto;
		padding-top: 1.5rem;
		border-top: 1px solid var(--gray-50);
	}

	.work-card-meta-left {
		display: flex;
		align-items: baseline;
		gap: 0.75rem;
	}

	.work-card-badge {
		font-size: 0.625rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--gray-500);
		background: var(--gray-100);
		padding: 0.25rem 0.5rem;
		border-radius: 0.25rem;
		font-weight: 700;
	}

	.work-card-project {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		color: var(--gray-400);
	}

	.work-card-view {
		font-family: var(--font-mono);
		font-size: 0.625rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--gray-400);
		opacity: 0;
		transition: opacity 0.3s ease;
	}

	.work-card:hover .work-card-view {
		opacity: 1;
	}
</style>
