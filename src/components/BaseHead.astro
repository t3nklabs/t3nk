---
// Central head for every page: favicon, meta, canonical, Open Graph/Twitter
// and the site's two typefaces (Inter + JetBrains Mono, as loaded in t3nk-old).
import '../styles/global.css';
import { SITE_TITLE, SITE_DESCRIPTION, asset } from '../consts';

interface Props {
	title?: string;
	description?: string;
	/** Absolute /public path to the share image. */
	image?: string;
	/** og:image:alt — plain description of the share image. */
	imageAlt?: string;
	/** og:type — "website" everywhere, "article" on content pages. */
	ogType?: 'website' | 'article';
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const {
	title,
	description = SITE_DESCRIPTION,
	image = asset('/banner.png'),
	imageAlt = 'T3NK — Capital + Code',
	ogType = 'website',
} = Astro.props;
const pageTitle = title ? `${title} — T3NK` : SITE_TITLE;
const imageURL = new URL(image, Astro.site);
const imageType = imageURL.pathname.endsWith('.png') ? 'image/png' : undefined;
const siteURL = new URL('/', Astro.site).toString();
---

<link rel="icon" type="image/svg+xml" href={asset('/favicon.svg')} />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={new URL('rss.xml', Astro.site)} />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="theme-color" content="#ffffff" />
<meta name="generator" content={Astro.generator} />
<meta name="author" content="T3NK" />
<meta name="keywords" content="venture capital, engineering-first VC, technical co-founder, seed funding, startup incubation, software engineering" />

<link rel="canonical" href={canonicalURL} />

<title>{pageTitle}</title>
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content="T3NK" />
<meta property="og:locale" content="en_US" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
<meta property="og:image:alt" content={imageAlt} />
{imageType && <meta property="og:image:type" content={imageType} />}
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />

<!-- Structured data: who runs the site + the site itself -->
<script
	is:inline
	type="application/ld+json"
	set:html={JSON.stringify({
		'@context': 'https://schema.org',
		'@type': 'Organization',
		'@id': `${siteURL}#organization`,
		name: 'T3NK',
		url: siteURL,
		logo: new URL(asset('/favicon.svg'), Astro.site).toString(),
		description: SITE_DESCRIPTION,
		sameAs: ['https://github.com/t3nklabs'],
	})}
/>
<script
	is:inline
	type="application/ld+json"
	set:html={JSON.stringify({
		'@context': 'https://schema.org',
		'@type': 'WebSite',
		'@id': `${siteURL}#website`,
		name: SITE_TITLE,
		url: siteURL,
		publisher: { '@id': `${siteURL}#organization` },
	})}
/>

<!-- Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
	href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap"
	rel="stylesheet"
/>
