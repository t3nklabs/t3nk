---
// One row of the posts index. `no` is the post's global number, newest = highest.
import FormattedDate from './FormattedDate.astro';
import { url } from '../consts';
import type { CollectionEntry } from 'astro:content';

interface Props {
	post: CollectionEntry<'posts'>;
	no: number;
}

const { post, no } = Astro.props;
---

<a href={url(`posts/${post.id}`)} class="post-row" aria-label={post.data.title}>
	<span class="post-no">#{String(no).padStart(2, '0')}</span>
	<div class="post-main">
		<h2 class="post-title">{post.data.title}</h2>
		<p class="post-desc">{post.data.desc}</p>
		{
			post.data.tags.length > 0 && (
				<div class="post-tags">
					{post.data.tags.map((tag) => (
						<span class="post-tag">{tag}</span>
					))}
				</div>
			)
		}
	</div>
	<div class="post-side">{post.data.date && <FormattedDate date={post.data.date} />}</div>
</a>

<style>
	.post-row {
		display: grid;
		grid-template-columns: 3.5rem 1fr auto;
		gap: 1rem;
		align-items: start;
		padding: 1.5rem;
		background: var(--white);
		border: 1px solid var(--gray-100);
		border-radius: 0.75rem;
		transition: border-color 0.3s ease, transform 0.3s ease;
	}

	.post-row:hover {
		border-color: var(--black);
		transform: translateY(-0.25rem);
	}

	.post-no {
		font-family: var(--font-mono);
		font-size: 0.875rem;
		color: var(--gray-400);
		padding-top: 0.25rem;
	}

	.post-title {
		font-size: 1.375rem;
		font-weight: 800;
		letter-spacing: -0.015em;
		margin-bottom: 0.5rem;
	}

	.post-desc {
		font-size: 0.9375rem;
		color: var(--gray-500);
		line-height: 1.625;
	}

	.post-tags {
		display: flex;
		gap: 0.375rem;
		margin-top: 0.75rem;
	}

	.post-tag {
		font-family: var(--font-mono);
		font-size: 0.625rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--gray-500);
		background: var(--gray-100);
		padding: 0.25rem 0.5rem;
		border-radius: 0.25rem;
		font-weight: 700;
	}

	.post-side {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--gray-400);
		padding-top: 0.35rem;
		white-space: nowrap;
	}

	@media (max-width: 640px) {
		.post-row {
			grid-template-columns: 1fr;
			gap: 0.5rem;
		}
		.post-side {
			order: -1;
		}
	}
</style>
