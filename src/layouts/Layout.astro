---
// Global shell: head, fixed header and the shared noise canvas.
// Pages own their background (white by default, black on dark pages).
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import NoiseCanvas from '../components/NoiseCanvas.astro';

interface Props {
	title?: string;
	description?: string;
	image?: string;
	/** og:type — "website" everywhere, "article" on content pages. */
	ogType?: 'website' | 'article';
}
const { title, description, image, ogType } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={image} ogType={ogType} />
	</head>
	<body>
		<NoiseCanvas />
		<Header />
		<main>
			<slot />
		</main>
	</body>
</html>
